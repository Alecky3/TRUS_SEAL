@inject SignInManager<TSUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<nav class="mt-4 py-4">
    <ul class="space-y-2 bg-white dark:bg-gray-900 p-4 rounded-lg shadow-md">
        <li>
            <a class="block py-2 px-4 rounded-lg text-sm font-medium @(ManageNavPages.IndexNavClass(ViewContext)) hover:bg-gray-100 dark:hover:bg-gray-700" id="profile" asp-page="./Index">
                Profile
            </a>
        </li>
        <li>
            <a class="block py-2 px-4 rounded-lg text-sm font-medium @(ManageNavPages.EmailNavClass(ViewContext)) hover:bg-gray-100 dark:hover:bg-gray-700" id="email" asp-page="./Email">
                Email
            </a>
        </li>
        <li>
            <a class="block py-2 px-4 rounded-lg text-sm font-medium @(ManageNavPages.ChangePasswordNavClass(ViewContext)) hover:bg-gray-100 dark:hover:bg-gray-700" id="change-password" asp-page="./ChangePassword">
                Password
            </a>
        </li>
        @if (hasExternalLogins)
        {
            <li>
                <a class="block py-2 px-4 rounded-lg text-sm font-medium @(ManageNavPages.ExternalLoginsNavClass(ViewContext)) hover:bg-gray-100 dark:hover:bg-gray-700" id="external-login" asp-page="./ExternalLogins">
                    External logins
                </a>
            </li>
        }
        <li>
            <a class="block py-2 px-4 rounded-lg text-sm font-medium @(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)) hover:bg-gray-100 dark:hover:bg-gray-700" id="two-factor" asp-page="./TwoFactorAuthentication">
                Two-factor authentication
            </a>
        </li>
        <li>
            <a class="block py-2 px-4 rounded-lg text-sm font-medium @(ManageNavPages.PersonalDataNavClass(ViewContext)) hover:bg-gray-100 dark:hover:bg-gray-700" id="personal-data" asp-page="./PersonalData">
                Personal data
            </a>
        </li>
    </ul>
</nav>