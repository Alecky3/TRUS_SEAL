@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
<div class="container w-1/3 mx-auto px-4">
    <div class="flex justify-center">
        <div class="w-full md:w-2/3 lg:w-1/3">
            <div class="bg-white shadow-md rounded-lg mt-5">
                <div class="p-4">
                    <div class="text-center mb-4">
                        <h1 class="text-2xl font-semibold mb-3">Log in</h1>
                        <p class="text-gray-600">Access your account.</p>
                    </div>
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-red-500" role="alert"></div>
                        <div class="mb-3">
                            <input asp-for="Input.Email" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" autocomplete="username" aria-required="true" placeholder="Email" />
                            <span asp-validation-for="Input.Email" class="text-red-500"></span>
                        </div>
                        <div class="mb-3">
                            <input asp-for="Input.Password" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" autocomplete="current-password" aria-required="true" placeholder="Password" type="password" />
                            <span asp-validation-for="Input.Password" class="text-red-500"></span>
                        </div>
                        <div class="mb-3">
                            <div class="flex items-center">
                                <input class="w-4 h-4 text-blue-600 mr-2 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600" asp-for="Input.RememberMe" />
                                <label class="text-gray-700" asp-for="Input.RememberMe">
                                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                                </label>
                            </div>
                        </div>
                        <button id="login-submit" type="submit" class="w-full bg-gray-800 text-white py-2 px-4 rounded-md hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-600 focus:ring-opacity-50">Log in</button>
                    </form>
                    <br class="my-4">
                    <div class="text-center space-y-2">
                        <p>
                            <a id="forgot-password" class="  text-blue-500 text-sm hover:underline" asp-page="./ForgotPassword">Forgot your password?</a>
                        </p>
                        <p>
                            <a id="resend-confirmation" class="text-blue-500 text-sm hover:underline" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                        </p>
                    </div>
                </div>
            </div>
            <div class="bg-white mt-2 rounded-lg">
                <div class="p-4 text-center">
                    Don't have an account? <a class="font-medium text-blue-600 dark:text-blue-500 hover:underline" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
