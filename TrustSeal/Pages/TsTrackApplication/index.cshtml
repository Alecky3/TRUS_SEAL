@page
@model TrustSeal.Pages.TsTrackApplication.IndexModel

@{
    ViewData["Title"] = "index";
}

<section class="p-4 flex mx-auto  justify-center items-center  bg-white dark:bg-gray-900">

    <h3 class="my-4 ">
        Application Tracking For <span class="text-xl font-medium text-gray-900 dark:text-white">@Html.DisplayFor(model => model.Business.LegalName)</span>
    </h3>
    <br  />
</section>

<section class=" bg-white dark:bg-gray-900 p-4 ">

    <div class="w-full flex justify-center">
        <img class="object-contain h-64 w-64" src="/assets/applied.png" alt="Descriptive Alt Text" />
    </div>

    <div class="w-full items-center">
        <ol id="stepper" class="flex items-center w-md  mx-auto mb-4 sm:mb-5 mx-auto">
            <li class="flex w-full items-center after:content-[''] after:w-full after:h-1 after:border-b after:border-gray-100 after:border-4 after:inline-block dark:after:border-gray-700" data-step-name="Business Information">
                <div class="flex flex-col items-center">
                    <div class="flex items-center justify-center w-10 h-10 bg-gray-100 rounded-full lg:h-12 lg:w-12 dark:bg-gray-700 shrink-0 mb-2">
                        <svg class="w-4 h-4 text-primary-600 lg:w-6 lg:h-6 dark:text-primary-300 question-mark" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <svg class="w-6 h-6 text-green-600 dark:text-green-300 check-mark hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div class="text-xs font-bold text-center w-20 overflow-hidden text-ellipsis"> Submitted</div>
                </div>
            </li>
            <li class="flex w-full items-center after:content-[''] after:w-full after:h-1 after:border-b after:border-gray-100 after:border-4 after:inline-block dark:after:border-gray-700" data-step-name="Business Information">
                <div class="flex flex-col items-center">
                    <div class="flex items-center justify-center w-10 h-10 bg-gray-100 rounded-full lg:h-12 lg:w-12 dark:bg-gray-700 shrink-0 mb-2">
                        <svg class="w-4 h-4 text-primary-600 lg:w-6 lg:h-6 dark:text-primary-300 question-mark" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <svg class="w-6 h-6 text-green-600 dark:text-green-300 check-mark hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div class="text-xs font-bold text-center w-20 overflow-hidden text-ellipsis">In Review</div>
                </div>
            </li>
            <li class="flex w-full items-center" data-step-name="Business Information">
                <div class="flex flex-col items-center">
                    <div class="flex items-center justify-center w-10 h-10 bg-gray-100 rounded-full lg:h-12 lg:w-12 dark:bg-gray-700 shrink-0 mb-2">
                        <svg class="w-4 h-4 text-primary-600 lg:w-6 lg:h-6 dark:text-primary-300 question-mark" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <svg class="w-6 h-6 text-green-600 dark:text-green-300 check-mark hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div class="text-xs font-bold text-center w-20 overflow-hidden text-ellipsis">Approved</div>
                </div>
            </li>
        </ol>

    </div>
</section>





