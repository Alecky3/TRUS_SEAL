@page
@model TrustSeal.Pages.SealPreview.IndexModel

@{
    ViewData["Title"] = "Seal Review";
}

<style>
        @* body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        } *@
.certificate-container {
    @* width: 80%; *@
    @* max-width: 900px; *@
    @* margin: 50px auto; *@
    padding: 30px;
    border: 10px solid #0a220b;
    border-radius: 15px;
    background-color: #fff;
    text-align: center;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25), 
                0 6px 6px rgba(0, 0, 0, 0.22); /* Enhanced shadow effect */
}


        .certificate-header {
            font-size: 2.5em;
            font-weight: bold;
            color: #0a220b;
            margin-bottom: 20px;
        }

        .certificate-subheader {
            font-size: 1.5em;
            margin-top: 10px;
            margin-bottom: 20px;
            color: #333;
        }

        .certificate-name {
            font-size: 2em;
            font-weight: bold;
            color: #000;
            margin: 20px 0;
        }

        .certificate-content {
            font-size: 1.2em;
            margin-bottom: 30px;
            color: #555;
            line-height: 1.6;
        }

        .certificate-badge {
    display: block; /* Ensures the image is treated as a block element */
    margin: 20px auto; /* Centers the image horizontally */
    max-width: 200px; /* Adjust the size as needed */
    height: auto; /* Maintains aspect ratio */
    border-radius: 10px; /* Optional: adds slightly rounded corners */
    box-shadow: 0 6px 8px rgba(0, 0, 0, 0.3); /* Optional: shadow effect */
}


        .certificate-footer {
            margin-top: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .certificate-signature img {
            max-width: 150px;
        }

        .certificate-date {
            font-size: 1.2em;
            color: #666;
        }

        .download-btn {
            margin-top: 20px;
            padding: 10px 20px;
            font-size: 1em;
            background-color: #1c311c;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
        }

        .download-btn:hover {
            background-color: #45a049;
        }
    </style>
 <div class="grid grid-cols-1 md:grid-cols-3 gap-2 md:gap-4 mb-4 border border-2 border-gray-100 p-2 rounded-md">
    <div>
         <div>
            <div class="certificate-container">
            <div class="certificate-header">Trust Seal Badge</div>
            <img src="@Url.Content("~/Badges/badge.svg")" alt="Trust Badge" class="certificate-badge">
            <div class="certificate-subheader">This is to certify that</div>
            <div class="certificate-name">@Model.Seal.Business.Owner.FirstName</div>
            <div class="certificate-content">
                Has successfully completed the <strong>Business Verification</strong><br>
                on <strong>@Model.Seal.CreatedAt.ToShortDateString()</strong>.
            </div>
            <div class="certificate-footer">
                <div class="certificate-signature">
                    <img src="@Url.Content("~/Badges/signature.png")" alt="CEO Signature">
                    <p>CEO Signature</p>
                </div>
                <div class="certificate-date">Issued on: @Model.Seal.CreatedAt.ToShortDateString()</div>
            </div>
           
        </div>
    </div>
    </div>
    <div class="col-span-2">
        <!-- List Group -->
        <ul class="mt-3 flex flex-col rounded-md">
            <li class="inline-flex items-center gap-x-2 py-3 px-4 text-sm border text-gray-800 -mt-px first:rounded-t-lg first:mt-0 last:rounded-b-lg dark:border-neutral-700 dark:text-neutral-200">
                <div class="flex items-center justify-between w-full">
                <span>Business Name</span>
                <span>@Model.Seal.Business.LegalName</span>
                </div>
            </li>
            <li class="inline-flex items-center gap-x-2 py-3 px-4 text-sm border text-gray-800 -mt-px first:rounded-t-lg first:mt-0 last:rounded-b-lg dark:border-neutral-700 dark:text-neutral-200">
                <div class="flex items-center justify-between w-full">
                <span>Date Assigned</span>
                <span>@Model.Seal.CreatedAt</span>
                </div>
            </li>
            <li class="inline-flex items-center gap-x-2 py-3 px-4 text-sm font-semibold  border text-gray-800 -mt-px first:rounded-t-lg first:mt-0 last:rounded-b-lg dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-200">
                <div class="flex items-center justify-between w-full">
                <span>Valid Until</span>
                <span>@Model.Seal.ExpiresAt</span>
                </div>
            </li>
            
        </ul>
        <!-- End List Group -->
 
</div>