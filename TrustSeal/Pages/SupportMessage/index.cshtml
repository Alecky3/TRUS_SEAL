@page
@model TrustSeal.Pages.SupportMessage.IndexModel
@using Microsoft.AspNetCore.Identity
@using TrustSeal.Areas.Identity.Data

@inject UserManager<TSUser> UserManager

@{
    ViewData["Title"] = "Support";
    TSUser user = await UserManager.GetUserAsync(User);
    var role = await UserManager.GetRolesAsync(user);
    var IsAdmin = role.Contains("Admin");
}
<section class="h-full">
    @if(role.Contains("Admin"))
    {
        
        @foreach(var usr in Model.UserWithTickets)
        {
            
            @* Admin Code Here *@
            <div class="border border-1 rounded border-gray-200 p-2 mb-2">
                <div class="shrink-0 group block mb-1">
                    <div class="flex items-center">
                        <span class="inline-flex items-center justify-center size-[46px] rounded-full bg-gray-800 font-semibold text-white leading-none dark:bg-white dark:text-neutral-800">
                            @(usr.Email[0].ToString().ToUpper())@(usr.Email[1].ToString().ToUpper())
                        </span>
                        <div class="display: inline-block">
                            
                            <div class="ms-3 flex ">
                                <div>
                                    <h3 class="font-semibold text-gray-800 dark:text-white">@usr.Email</h3>
                                    <span class="bg-blue-100 text-blue-800 text-xs font-medium inline-flex items-center px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-blue-400 border border-blue-400">
                                        @usr.SupportTickets.Count()
                                        <span class="mr-2"></span>
                                        Ticket@(usr.SupportTickets.Count() > 1 ? 's':null) raised
                                    </span>
                                    @* Collapse *@
                                    <div style="display: inline-block;">
                                            <p class="mt-2">
                                            <button type="button" class="hs-collapse-toggle inline-flex items-center gap-x-1 text-sm font-semibold rounded-lg border border-transparent text-blue-600 decoration-2 hover:text-blue-700 hover:underline focus:outline-none focus:underline focus:text-blue-700 disabled:opacity-50 disabled:pointer-events-none dark:text-blue-500 dark:hover:text-blue-600 dark:focus:text-blue-600" id="hs-show-hide-collapse-@usr.Id" aria-expanded="false" aria-controls="hs-show-hide-collapse-heading-@usr.Id" data-hs-collapse="#hs-show-hide-collapse-heading-@usr.Id">
                                                <span class="hs-collapse-open:hidden">Show Messages</span>
                                                <span class="hs-collapse-open:block hidden">Hide Messages</span>
                                                <svg class="hs-collapse-open:rotate-180 shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="m6 9 6 6 6-6"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    @* End collapse *@
                                </div>
                            
                            </div>
                        </div>
                    </div>
                </div> 
            </div>
            @* Body Here *@
            @* Message List *@
            <div id="hs-show-hide-collapse-heading-@usr.Id" class="hs-collapse hidden h-full w-full overflow-hidden transition-[height] duration-300 border border-1 rounded border-gray-200 flex flex-col" style="height: calc(100% - 120px);" aria-labelledby="hs-show-hide-collapse-@usr.Id">
                <div class="max-h-[400px] overflow-y-auto
                [&::-webkit-scrollbar]:w-2
                [&::-webkit-scrollbar-track]:bg-gray-100
                [&::-webkit-scrollbar-thumb]:bg-gray-300
                dark:[&::-webkit-scrollbar-track]:bg-neutral-700
                dark:[&::-webkit-scrollbar-thumb]:bg-neutral-500">
                @* Messages *@
                <ul id="message-list" class="px-2 py-4">
                   @foreach(var mssg in usr.SupportTickets)
                    {
                        <div class="flex items-start gap-2.5">
                            <div class="flex flex-col gap-1 w-full max-w-[320px]">
                                <div class="flex items-center space-x-2 rtl:space-x-reverse">
                                    <span class="text-sm font-semibold text-gray-900 dark:text-white">You</span>
                                    <span class="text-sm font-normal text-gray-500 dark:text-gray-400">@mssg.CreatedAt</span>
                                    <span class="text-sm font-normal text-gray-500 dark:text-gray-400 ms-4">@mssg.TicketNumber</span>
                                </div>
                                <div class="flex flex-col leading-1.5 p-4 border-gray-200 bg-gray-100 rounded-e-xl rounded-es-xl dark:bg-gray-700">
                                    <p class="text-sm font-normal text-gray-900 dark:text-white">@mssg.Message</p>
                                    <div>
                                        @if(@mssg.SupportAttachments !=null)
                                        {
                                            @foreach(var file in mssg.SupportAttachments)
                                            {
                                            <p><a class="text-blue-600 underline underline-offset-1 decoration-blue-600 hover:opacity-80 focus:outline-none focus:opacity-80" href="/SupportMessage?handler=SupportAttachment&id=@file.Id">@file.DisplayName</a></p>
                                            }
                                        }
                                    </div>
                                </div>
                                
                            </div>
                            <button id="dropdownMenuIconButton-@mssg.Id" data-dropdown-toggle="dropdownDots-@mssg.Id" data-dropdown-placement="bottom-start" class="inline-flex self-center items-center p-2 text-sm font-medium text-center text-gray-900 bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none dark:text-white focus:ring-gray-50 dark:bg-gray-900 dark:hover:bg-gray-800 dark:focus:ring-gray-600" type="button">
                                <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 4 15">
                                    <path d="M3.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 6.041a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 5.959a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/>
                                </svg>
                            </button>
                            <div id="dropdownDots-@mssg.Id" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-40 dark:bg-gray-700 dark:divide-gray-600">
                                <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="dropdownMenuIconButton">
                                    <li>
                                        <a href="#" data-modal-target="reply-message-@mssg.Id" data-modal-toggle="reply-message-@mssg.Id" type="button" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Reply</a>
                                        @* Add New Attachment Config Modal *@
                                        <div id="reply-message-@mssg.Id" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] max-h-full">
                                            <div class="relative p-4 w-full max-w-md max-h-full">
                                                <!-- Modal content -->
                                                <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
                                                    <!-- Modal header -->
                                                    <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
                                                        <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                                                            Reply Message
                                                        </h3>
                                                        <button type="button" class="end-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="reply-message-@mssg.Id">
                                                            <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                                                            </svg>
                                                            <span class="sr-only">Close modal</span>
                                                        </button>
                                                    </div>
                                                    <!-- Modal body -->
                                                    <div class="p-4 md:p-5">
                                                        <form data-form="attachment-config-business-information" class="space-y-4" method="POST">
                                                            <input type="text" name="AttachmentConfig.category" value="Business Information" hidden>
                                                            <div>
                                                                <label for="AttachmentConfig.ForWhichField" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">ForWhichField</label>
                                                                <input type="text" name="AttachmentConfig.ForWhichField" id="AttachmentConfig.ForWhichField" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white"  required />
                                                            </div>
                                                            <div>
                                                                <label for="AttachmentConfig.Required" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Required</label>
                                                                <select  id="AttachmentConfig.Required" name="AttachmentConfig.Required" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                                                    <option selected value="0">False</option>
                                                                    <option value="1">True</option>
                                                                </select>
                                                            </div>
                                                            <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
                                                                <button  type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Save</button>
                                                                <button data-modal-hide="add-attachmentconfig-modal-business-info" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Cancel</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div> 
                                        @* End Add New Attachment Config Modal *@
                                    </li>
                                    <li>
                                        <a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Edit</a>
                                    </li>
                                    <li>
                                        <a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Delete</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    } 
                </ul>
                @* End of Messages *@
                    </div>
                    <div style="margin-top: auto;">
                        <div id="attached-uposted-files" class="p-2">
                        
                        </div>
                        <!-- Textarea -->
                        <div class="relative">
                        <form action="" method="post" class="mb-2">
                        <textarea id="message-content" class="p-4 pb-12 block w-full bg-gray-100 border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600" placeholder="Type You Message Here" data-hs-textarea-auto-height=""></textarea>
                        </form>

                        <!-- Toolbar -->
                        <div class="absolute bottom-px inset-x-px p-2 rounded-b-md bg-gray-100 dark:bg-neutral-800">
                            <div class="flex justify-between items-center">
                            <!-- Button Group -->
                            <div class="flex items-center">

                                <!-- Attach Button -->
                                <button type="button" id="message-attach-file" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                                <form action="" method="post">
                                    <input type="file" hidden name="message-attachment">
                                </form>
                                <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                                </svg>
                                </button>
                                <!-- End Attach Button -->
                            </div>
                            <!-- End Button Group -->

                            <!-- Button Group -->
                            <div class="flex items-center gap-x-1">
                            
                                <!-- Send Button -->
                                <button type="button" id="message-send" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                                <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083l6-15Zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471-.47 1.178Z"></path>
                                </svg>
                                </button>
                                <!-- End Send Button -->
                            </div>
                            <!-- End Button Group -->
                            </div>
                        </div>
                        <!-- End Toolbar -->
                        </div>
                        <!-- End Textarea -->
                    </div>
                </div>
            @* End Message List *@
            @* End Body Here *@

        }
        
    } else{
    <div class="shrink-0 group block mb-4">
        <div class="flex items-center">
            <span class="inline-flex items-center justify-center size-[46px] rounded-full bg-gray-800 font-semibold text-white leading-none dark:bg-white dark:text-neutral-800">
                @(user.Email[0].ToString().ToUpper()) @(user.Email[1].ToString().ToUpper())
            </span>
            <div class="ms-3">
                <h3 class="font-semibold text-gray-800 dark:text-white">@user.Email</h3>
                <span class="bg-blue-100 text-blue-800 text-xs font-medium inline-flex items-center px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-blue-400 border border-blue-400">
                    <span class="mr-2">@Model.SupportMessages.Count()</span>
                    Tickets raised
                </span>
            </div>
        </div>
    </div> 
    <div class="border border-1 rounded border-gray-200 flex flex-col" style="height: calc(100% - 120px);">
        <div class="max-h-[400px] overflow-y-auto
        [&::-webkit-scrollbar]:w-2
        [&::-webkit-scrollbar-track]:bg-gray-100
        [&::-webkit-scrollbar-thumb]:bg-gray-300
        dark:[&::-webkit-scrollbar-track]:bg-neutral-700
        dark:[&::-webkit-scrollbar-thumb]:bg-neutral-500">
        <ul id="message-list" class="px-2 py-4">
            @foreach(var mssg in Model.SupportMessages)
            {
                if(mssg.ReplyToId == null)
                {
                    <div class="flex items-start gap-2.5">
                    <div class="flex flex-col gap-1 w-full max-w-[320px]">
                        <div class="flex items-center space-x-2 rtl:space-x-reverse">
                            <span class="text-sm font-semibold text-gray-900 dark:text-white">You</span>
                            <span class="text-sm font-normal text-gray-500 dark:text-gray-400">@mssg.CreatedAt</span>
                            <span class="text-sm font-normal text-gray-500 dark:text-gray-400 ms-4">@mssg.TicketNumber</span>
                        </div>
                        <div class="flex flex-col leading-1.5 p-4 border-gray-200 bg-gray-100 rounded-e-xl rounded-es-xl dark:bg-gray-700">
                            <p class="text-sm font-normal text-gray-900 dark:text-white">@mssg.Message</p>
                            <div>
                                @if(@mssg.SupportAttachments !=null)
                                {
                                    @foreach(var file in mssg.SupportAttachments)
                                    {
                                    <p style="overflow: hidden;"><a class="text-blue-600 underline underline-offset-1 decoration-blue-600 hover:opacity-80 focus:outline-none focus:opacity-80" href="/SupportMessage?handler=SupportAttachment&id=@file.Id">@file.DisplayName</a></p>
                                    }
                                }
                            </div>
                        </div>
                        
                    </div>
                    <button id="dropdownMenuIconButton-@mssg.Id" data-dropdown-toggle="dropdownDots-@mssg.Id" data-dropdown-placement="bottom-start" class="inline-flex self-center items-center p-2 text-sm font-medium text-center text-gray-900 bg-white rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none dark:text-white focus:ring-gray-50 dark:bg-gray-900 dark:hover:bg-gray-800 dark:focus:ring-gray-600" type="button">
                        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 4 15">
                            <path d="M3.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 6.041a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 5.959a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/>
                        </svg>
                    </button>
                    <div id="dropdownDots-@mssg.Id" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-40 dark:bg-gray-700 dark:divide-gray-600">
                        <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="dropdownMenuIconButton">
                            <li>
                                <a href="#" aria-haspopup="dialog" aria-expanded="false" aria-controls="reply-message-modal-@mssg.Id" data-hs-overlay="#reply-message-modal-@mssg.Id" type="button" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Reply</a>
                                
                            </li>
                            <li>
                                <a href="#" aria-haspopup="dialog" aria-expanded="false" aria-controls="edit-message-modal-@mssg.Id" data-hs-overlay="#edit-message-modal-@mssg.Id" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Edit</a>
                            </li>
                            <li>
                                <a href="#" aria-haspopup="dialog" aria-expanded="false" aria-controls="delete-message-modal-@mssg.Id" data-hs-overlay="#delete-message-modal-@mssg.Id" type="button" class="block px-4 py-2 bg-red-300 hover:bg-red-600 dark:hover:bg-gray-600 dark:hover:text-white">Delete</a>
                            </li>
                        </ul>
                    </div>
                    @* Start Delete Dialog *@
                                    <div id="delete-message-modal-@mssg.Id" class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none" role="dialog" tabindex="-1" aria-labelledby="delete-message-modal-@mssg.Id-label">
                                    <div class="hs-overlay-animation-target hs-overlay-open:scale-100 hs-overlay-open:opacity-100 scale-95 opacity-0 ease-in-out transition-all duration-200 sm:max-w-lg sm:w-full m-3 sm:mx-auto min-h-[calc(100%-3.5rem)] flex items-center">
                                        <div class="w-full flex flex-col bg-white border shadow-sm rounded-xl pointer-events-auto dark:bg-neutral-800 dark:border-neutral-700 dark:shadow-neutral-700/70">
                                        <div class="flex justify-between items-center py-3 px-4 border-b dark:border-neutral-700">
                                            <h3 id="reply-message-modal-@mssg.Id-label" class="font-bold text-gray-800 dark:text-white">
                                            Confirm Delete Message
                                            </h3>
                                            <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200 focus:outline-none focus:bg-gray-200 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-700 dark:hover:bg-neutral-600 dark:text-neutral-400 dark:focus:bg-neutral-600" aria-label="Close" data-hs-overlay="#delete-message-modal-@mssg.Id">
                                            <span class="sr-only">Close</span>
                                            <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M18 6 6 18"></path>
                                                <path d="m6 6 12 12"></path>
                                            </svg>
                                            </button>
                                        </div>
                                       
                                       <div class="flex items-start gap-2.5 ms-2">
                                            <div class="flex flex-col gap-1 w-full max-w-[320px]">
                                                <div class="flex items-center space-x-2 rtl:space-x-reverse">
                        
                                                    <span class="text-sm font-normal text-gray-500 dark:text-gray-400">@mssg.CreatedAt</span>
                                                    <span class="text-sm font-normal text-gray-500 dark:text-gray-400 ms-4">@mssg.TicketNumber</span>
                                                </div>
                                                <div class="flex flex-col leading-1.5 p-4 border-gray-200 bg-gray-100 rounded-e-xl rounded-es-xl dark:bg-gray-700">
                                                    <p class="text-sm font-normal text-gray-900 dark:text-white">@mssg.Message</p>
                                                    <div>
                                                        @if(@mssg.SupportAttachments !=null)
                                                        {
                                                            @foreach(var file in mssg.SupportAttachments)
                                                            {
                                                            <p><a class="text-blue-600 underline underline-offset-1 decoration-blue-600 hover:opacity-80 focus:outline-none focus:opacity-80" href="/SupportMessage?handler=SupportAttachment&id=@file.Id">@file.DisplayName</a></p>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                                
                                            </div>
                                       </div>
                                      
                                        <div class="p-4 overflow-y-auto">
                                            <form data-form="delete-message-form" class="space-y-4" method="POST">
                                                <input type="text" name="Message.Id" value="@mssg.Id" hidden>
                                               <div class="flex justify-end items-center gap-x-2 py-3 px-4 border-t dark:border-neutral-700">
                                                    <button type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 focus:outline-none focus:bg-gray-50 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:text-white dark:hover:bg-neutral-700 dark:focus:bg-neutral-700" data-hs-overlay="#delete-message-modal-@mssg.Id">
                                                    Close
                                                    </button>
                                                    <button   type="submit" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-transparent bg-red-600 text-white hover:bg-red-700 focus:outline-none focus:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none">
                                                    Delete
                                                    </button>
                                                </div>
                                            </form>
                            
                                        </div>
                                        
                                        </div>
                                    </div>
                                    </div>    
                                @* End Delete dialog *@
                                @* Start Reply Dialog *@
                                    <div id="reply-message-modal-@mssg.Id" class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none" role="dialog" tabindex="-1" aria-labelledby="reply-message-modal-@mssg.Id-label">
                                    <div class="hs-overlay-animation-target hs-overlay-open:scale-100 hs-overlay-open:opacity-100 scale-95 opacity-0 ease-in-out transition-all duration-200 sm:max-w-lg sm:w-full m-3 sm:mx-auto min-h-[calc(100%-3.5rem)] flex items-center">
