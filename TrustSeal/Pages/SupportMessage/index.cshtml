                                                                    @* End Delete File Icon *@
                                                                </div>
                                                            
                                                            }
                                                        }
                                                </div>
                                                <!-- Attach Button -->
                                               <div class="flex items-center">
                                                    <button data-attach="reply-message-files" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                                                       <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                                                        </svg>

                                                        <input type="file" hidden >
                                                    </button>
                                                    <span class="ml-2 ">Attach file(s)</span>
                                               </div>
                                               <div class="flex justify-end items-center gap-x-2 py-3 px-4 border-t dark:border-neutral-700">
                                                    <button id="reply-" type="button" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-800 shadow-sm hover:bg-gray-50 focus:outline-none focus:bg-gray-50 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-800 dark:border-neutral-700 dark:text-white dark:hover:bg-neutral-700 dark:focus:bg-neutral-700" data-hs-overlay="#reply-edit-message-modal-@reply.Id">
                                                    Close
                                                    </button>
                                                    <button  type="submit" class="py-2 px-3 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg border border-transparent bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:bg-blue-700 disabled:opacity-50 disabled:pointer-events-none">
                                                    Save changes
                                                    </button>
                                                </div>
                                            </form>
                            
                                        </div>
                                        
                                        </div>
                                    </div>
                                    </div>
                                @* End Edit Dialog *@
                            @* End Reply and Delete Dialogs *@
                        </div>
                        
                    }
                    
                </div>
                @* End Reply Messages Container *@
                }
            }
        </ul>
        </div>
        <div style="margin-top: auto;">
            <div id="attached-uposted-files" class="p-2">
               
            </div>
            <!-- Textarea -->
            <div class="relative">
            <form action="" method="post" class="mb-2">
              <textarea id="message-content" class="p-4 pb-12 block w-full bg-gray-100 border-gray-200 rounded-lg text-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-400 dark:placeholder-neutral-500 dark:focus:ring-neutral-600" placeholder="Type You Message Here" data-hs-textarea-auto-height=""></textarea>
            </form>

            <!-- Toolbar -->
            <div class="absolute bottom-px inset-x-px p-2 rounded-b-md bg-gray-100 dark:bg-neutral-800">
                <div class="flex justify-between items-center">
                <!-- Button Group -->
                <div class="flex items-center">

                    <!-- Attach Button -->
                    <button type="button" id="message-attach-file" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                    <form action="" method="post">
                        <input type="file" hidden name="message-attachment">
                    </form>
                    <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                    </svg>
                    </button>
                    <!-- End Attach Button -->
                </div>
                <!-- End Button Group -->

                <!-- Button Group -->
                <div class="flex items-center gap-x-1">
                   
                    <!-- Send Button -->
                    <button type="button" id="message-send" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                    <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083l6-15Zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471-.47 1.178Z"></path>
                    </svg>
                    </button>
                    <!-- End Send Button -->
                </div>
                <!-- End Button Group -->
                </div>
            </div>
            <!-- End Toolbar -->
            </div>
            <!-- End Textarea -->
        </div>
    </div>
    }
</section>

@section Scripts{
    <script>
        let attachBtn =document.querySelectorAll('#message-attach-file')[0]
        let sendMessageBtn=document.querySelectorAll("#message-send")[0]
        sendMessageBtn.disabled=true;
        let attachedFilesCon = document.querySelectorAll("#attached-uposted-files")[0]
        let messageTextArea =document.querySelectorAll("#message-content")[0];
        let replyMessageForms =document.querySelectorAll("form[data-form='reply-message-form']");
        let editMessageForms =document.querySelectorAll("form[data-form='edit-message-form']");
        let deleteMessageForms =document.querySelectorAll("form[data-form='delete-message-form']");
        
        let removeFilesBtns =document.querySelectorAll("button[data-remove-file='remove-file']");
        
        messageTextArea.addEventListener("change",e=>
            {
                sendMessageBtn.disabled=false;

            }
        )
        attachBtn.addEventListener("click",(e)=>{
            let attachInput = document.querySelectorAll("input[name='message-attachment']")[0];
            attachBtn.addEventListener("change",handlePostSupportFiles);
            if(attachInput)
            {
                attachInput.click();
            }
        })
        sendMessageBtn.addEventListener("click",handlePostNewMessage);

        replyMessageForms.forEach(replyToForm=>{
            let replyAttachmentBtn = replyToForm.querySelector("button[data-attach='reply-message-files']");
            if(removeFilesBtns)
            {
                 replyAttachmentBtn.addEventListener("click",(e)=>{
                    let inputFile=e.target.querySelector('input')
                    if(inputFile)
                    {
                        inputFile.addEventListener("change",(e)=>{
                            handlePostUploadReplyFile(e)
                        })
                        inputFile.click();
                    }
                })
            }
           
            replyToForm.addEventListener("submit",(e)=>{
                e.preventDefault()
                console.log("Reply submit Clicked")
                handlePostReplyMessage(e)
            })
        })
        editMessageForms.forEach(replyToForm=>{
            let replyAttachmentBtn = replyToForm.querySelector("button[data-attach='reply-message-files']");
            if(replyAttachmentBtn)
            {
                replyAttachmentBtn.addEventListener("click",(e)=>{
                let inputFile=e.target.querySelector('input')
                if(inputFile)
                {
                    inputFile.addEventListener("change",(e)=>{
                        handlePostUploadReplyFile(e)
                    })
                    inputFile.click();
                }
            })
            }
            
            replyToForm.addEventListener("submit",(e)=>{
                e.preventDefault()
                console.log("Edit submit Clicked")
                handlePostEditMessage(e)
            })
        })
        deleteMessageForms.forEach(deleteForm=>{
            deleteForm.addEventListener("submit",(e)=>{
                e.preventDefault();
                console.log("Delete Message");
                handleDeleteMessage(e);
            })
        })

        removeFilesBtns.forEach(rmBtn=>{
            rmBtn.addEventListener("click",handleRemoveFile)
        })
        function handlePostSupportFiles(e)
        {
            let input=e.target;
            let formData = new FormData();
            for(let file of input.files)
            {
                formData.append("file",file,file.name);
            }
            const token = document.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/SupportMessage?handler=SupportFile", {
                method: "POST",
                headers: {
                    RequestVerificationToken: token
                },
                body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                let fileLink = document.createElement('p');
                fileLink.innerHTML =`<a class="text-blue-600 underline underline-offset-1 decoration-blue-600 hover:opacity-80 focus:outline-none focus:opacity-80" href="/SupportMessage?handler=SupportAttachment&id=${jsonRes.attachmentId}">${jsonRes.fileName}</a>
                <input hidden value='${jsonRes.attachmentId}'/>`
                attachedFilesCon.appendChild(fileLink);
                console.log(jsonRes)
            }).catch(err=>{
                console.error(err)
            })
            
        }

        function handlePostUploadReplyFile(e)
        {
           let input=e.target;
           let closestReplyMessageForm = e.target.closest("form");
           let replyMessageUploadedFilesCon =closestReplyMessageForm.querySelector("div[data-container='reply-message-file-attachments']");
            let formData = new FormData();
            for(let file of input.files)
            {
                formData.append("file",file,file.name);
            }
            const token = document.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/SupportMessage?handler=SupportFile", {
                method: "POST",
                headers: {
                    RequestVerificationToken: token
                },
                body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                let fileLink = document.createElement('div');
                fileLink.setAttribute("class","grid grid-cols-2 gap-4")
                fileLink.style.overflow="hidden";
                fileLink.innerHTML =`<a class="text-blue-600 underline underline-offset-1 decoration-blue-600 hover:opacity-80 focus:outline-none focus:opacity-80" href="/SupportMessage?handler=SupportAttachment&id=${jsonRes.attachmentId}">${jsonRes.fileName}</a>
                <input hidden name="fileId" value='${jsonRes.attachmentId}'/>`
                replyMessageUploadedFilesCon.appendChild(fileLink);
                console.log(jsonRes)
            }).catch(err=>{
                console.error(err)
            }) 
        }

        function handlePostNewMessage(e)
        {
            messageTextArea.disabled=true;
            let message=messageTextArea.value;
            let attachedFiles =attachedFilesCon.querySelectorAll('input');
            let formData =new FormData();
            formData.append("message",message);
            attachedFiles.forEach(input=>{
                formData.append('fileId',input.value)
            })
            const token = document.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/SupportMessage", {
                method: "POST",
                headers: {
                    RequestVerificationToken: token
                },
                body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                console.log(jsonRes)
                messageTextArea.value=''
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Successfully Created Ticket",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "success",
                  timer: 1500,
                  showConfirmButton: false
                })
                window.location.reload()
            }).catch(err=>{
                console.error(err)
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Error Creating Ticket",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "error",
                  timer: 1500,
                  showConfirmButton: false
                })
            })
        }

        function handlePostEditMessage(e)
        {
            let submitBtn = e.target.querySelector("button[type='submit']");
            submitBtn.innerHTML=`<span class="animate-spin inline-block size-4 border-[3px] border-current border-t-transparent text-white rounded-full" role="status" aria-label="loading"></span>
                            Saving Message`
            let messageTextArea=e.target.querySelector("textarea")
            messageTextArea.disabled=true;
            let message=messageTextArea.value;
            let formData =new FormData(e.target);
            formData.append("message",message);
            
            const token = document.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/SupportMessage?handler=EditSupportMessage", {
                method: "POST",
                headers: {
                    RequestVerificationToken: token
                },
                body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                console.log(jsonRes)
                messageTextArea.value=''
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Successfully Update Ticket",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "success",
                  timer: 1500,
                  showConfirmButton: false
                })
                submitBtn.innerHTML="Save Changes";
                window.location.reload()
            }).catch(err=>{
                console.error(err)
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Error Updating Ticket",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "error",
                  timer: 1500,
                  showConfirmButton: false
                })
                submitBtn.innerHTML="Save Changes";
            })
        }
        
        function handlePostReplyMessage(e)
        {
            let submitBtn = e.target.querySelector("button[type='submit']");
            submitBtn.innerHTML=`<span class="animate-spin inline-block size-4 border-[3px] border-current border-t-transparent text-white rounded-full" role="status" aria-label="loading"></span>
                            Saving Message`
            let messageTextArea=e.target.querySelector("textarea")
            messageTextArea.disabled=true;
            let message=messageTextArea.value;
            let formData =new FormData(e.target);
            formData.append("message",message);
            
            const token = document.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/SupportMessage?handler=ReplyMessage", {
                method: "POST",
                headers: {
                    RequestVerificationToken: token
                },
                body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                console.log(jsonRes)
                messageTextArea.value=''
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Successfully Created Ticket",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "success",
                  timer: 1500,
                  showConfirmButton: false
                })
                submitBtn.innerHTML="Save Changes";
                window.location.reload()
            }).catch(err=>{
                console.error(err)
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Error Creating Ticket",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "error",
                  timer: 1500,
                  showConfirmButton: false
                })
                submitBtn.innerHTML="Save Changes";
            })
        }

        function handleDeleteMessage(e)
        {
             let submitBtn = e.target.querySelector("button[type='submit']");
            submitBtn.innerHTML=`<span class="animate-spin inline-block size-4 border-[3px] border-current border-t-transparent text-white rounded-full" role="status" aria-label="loading"></span>
                            Saving Message`
            
            let formData =new FormData(e.target);
            
            const token = document.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/SupportMessage?handler=Delete", {
                method: "POST",
                headers: {
                    RequestVerificationToken: token
                },
                body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                console.log(jsonRes)
                messageTextArea.value=''
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Successfully Delete Message",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "success",
                  timer: 1500,
                  showConfirmButton: false
                })
                submitBtn.innerHTML="Delete";
                window.location.reload()
            }).catch(err=>{
                console.error(err)
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Error Deleting Message",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "error",
                  timer: 1500,
                  showConfirmButton: false
                })
                submitBtn.innerHTML="Delete";
            })
        }

        function handleRemoveFile(e)
        {
            let submitBtn = e.target;
            submitBtn.innerHTML=`<span class="animate-spin inline-block size-4 border-[3px] border-current border-t-transparent text-white rounded-full" role="status" aria-label="loading"></span>
                            Deleting File`
            let fileId = e.target.getAttribute("data-fileId")
        
            let formData =new FormData();
            formData.append("fileId",fileId);
            
            const token = document.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/SupportMessage?handler=DeleteFile", {
                method: "POST",
                headers: {
                    RequestVerificationToken: token
                },
                body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                console.log(jsonRes)
                messageTextArea.value=''
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Successfully Delete File",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "success",
                  timer: 1500,
                  showConfirmButton: false
                })
                submitBtn.innerHTML="Deleted";
                window.location.reload()
            }).catch(err=>{
                console.error(err)
                messageTextArea.disabled=false;
                Swal.fire({
                  text: "Error Deleting File",
                  toast: true,
                  position: "top-right",
                  timerProgressBar: true,
                  icon: "error",
                  timer: 1500,
                  showConfirmButton: false
                })
                submitBtn.innerHTML="Deleted";
            })
        }
    </script>
}


