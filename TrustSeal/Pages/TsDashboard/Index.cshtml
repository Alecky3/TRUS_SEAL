@section Scripts{
<script>
  let vbusinesses = @vBusinesses;
  let ubusinesses = @unVBusinesses

  //
  const data = {
  labels: [
    'Verified',
    'Unverified',
  ],
  datasets: [{
    label: 'User Analytics',
    data: [vbusinesses,ubusinesses],
    backgroundColor: [
      'rgb(255, 99, 132)',
      'rgb(54, 162, 235)',
    ],
    hoverOffset: 4
  }]
};
  //
  console.log(vbusinesses,ubusinesses)
    window.addEventListener('DOMContentLoaded', () => {
  try {
    const canvas = document.getElementById('user-analytics-chart');
    console.log(canvas)

    new Chart(canvas, {
      type: 'doughnut',
      data: data
    });
  } catch (err) {
    console.error("Failed to create chart:", err.message);
  }
});

</script>
}
