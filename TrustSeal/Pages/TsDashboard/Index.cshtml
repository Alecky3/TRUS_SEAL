@page
@model TrustSeal.Pages.TsDashboard.IndexModel
@using Microsoft.AspNetCore.Identity
@using TrustSeal.Areas.Identity.Data
@using TrustSeal.Models
@using System.Collections.Generic

@inject SignInManager<TSUser> SignInManager
@inject UserManager<TSUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject TSAuth db


@{
    ViewData["Title"] = "Dashboard";
    var vBusinesses = @Model.businesses.Where(b=>b.IsVerified==true).Count();
    var unVBusinesses = @Model.businesses.Where(b=>b.IsVerified==false).Count();
    var IsAdmin = true;
    List<Business> businesses = new List<Business>();
    @if (SignInManager.IsSignedIn(User))
    {
      var  user = await UserManager.GetUserAsync(User);
      businesses = db.Businesses.Where(b => b.OwnerId == user.Id).ToList();
    }
            
}
@if(SignInManager.IsSignedIn(User)){
  TSUser user = await UserManager.GetUserAsync(User);
  if(user !=null)
  {
    if(await UserManager.IsInRoleAsync(user,"user"))
    {
      IsAdmin=false;
    <div class="container mx-auto">
      @* statistics *@
      <div class="w-full bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
