@page
@model TrustSeal.Pages.TsDashboard.IndexModel
@using Microsoft.AspNetCore.Identity
@using TrustSeal.Areas.Identity.Data
@using TrustSeal.Models
@using System.Collections.Generic

@inject SignInManager<TSUser> SignInManager
@inject UserManager<TSUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject TSAuth db


@{
    ViewData["Title"] = "Dashboard";
    var vBusinesses = @Model.businesses.Where(b=>b.IsVerified==true).Count();
    var unVBusinesses = @Model.businesses.Where(b=>b.IsVerified==false).Count();
    List<Business> businesses = new List<Business>();
    @if (SignInManager.IsSignedIn(User))
    {
      var  user = await UserManager.GetUserAsync(User);
      businesses = db.Businesses.Where(b => b.OwnerId == user.Id).ToList();
    }
            
}
@if(SignInManager.IsSignedIn(User)){
  TSUser user = await UserManager.GetUserAsync(User);
  if(user !=null)
  {
    if(await UserManager.IsInRoleAsync(user,"user"))
    {
    <div class="container mx-auto">
      @* statistics *@
      <div class="w-full bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
          <div class="sm:hidden">
              <label for="tabs" class="sr-only">Select tab</label>
              <select id="tabs" data-tabs-toggle="#fullWidthTabContent" role="tablist" class="bg-gray-50 border-0 border-b border-gray-200 text-gray-900 text-sm rounded-t-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                  <option id="stats-tab-option1" data-tabs-target="#stats" type="button" role="tab" aria-controls="stats" aria-selected="true">Businesses</option>
                  <option id="about-tab-option2" data-tabs-target="#about" type="button" role="tab" aria-controls="about" aria-selected="false" >Seals</option>
              </select>
          </div>
          <ul class="hidden text-sm font-medium text-center text-gray-500 divide-x divide-gray-200 rounded-lg sm:flex dark:divide-gray-600 dark:text-gray-400 rtl:divide-x-reverse" id="fullWidthTab" data-tabs-toggle="#fullWidthTabContent" role="tablist">
              <li class="w-full">
                  <button id="stats-tab" data-tabs-target="#stats" type="button" role="tab" aria-controls="stats" aria-selected="true" class="inline-block w-full p-4 rounded-ss-lg bg-gray-50 hover:bg-gray-100 focus:outline-none dark:bg-gray-700 dark:hover:bg-gray-600">Businesses</button>
              </li>
              <li class="w-full">
                  <button id="about-tab" data-tabs-target="#about" type="button" role="tab" aria-controls="about" aria-selected="false" class="inline-block w-full p-4 bg-gray-50 hover:bg-gray-100 focus:outline-none dark:bg-gray-700 dark:hover:bg-gray-600">Seals</button>
              </li>
          </ul>
          <div id="fullWidthTabContent" class="border-t border-gray-200 dark:border-gray-600">
              <div class="hidden p-4 bg-white rounded-lg md:p-8 dark:bg-gray-800" id="stats" role="tabpanel" aria-labelledby="stats-tab">
                  <dl class="grid max-w-screen-xl grid-cols-1 gap-4 p-4 mx-auto text-gray-900 md:grid-cols-2 lg:grid-cols-3  dark:text-white sm:p-8">
                    <a href="#" class="block max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">

                      <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Total Registered Businesses</h5>
                      <p class="font-normal text-gray-700 dark:text-gray-400">@(@Model.businesses.Count() > 1 ? $"{@Model.businesses.Count()} Businesses" : $"{@Model.businesses.Count()} Business")</p>
                    </a>

                    <a href="#" class="block max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
                      @{
                        var verifiedBusinesses = @Model.businesses.Where(b=>b.IsVerified==true).Count();
                      }
                      <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Verified Businesses</h5>
                      <p class="font-normal text-gray-700 dark:text-gray-400">@(verifiedBusinesses > 1 ? $"{@verifiedBusinesses} Businesses" : $"{@verifiedBusinesses} Business")</p>
                    </a>
                    <a href="#" class="block max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
                      @{
                        var unVerifiedBusinesses = @Model.businesses.Where(b=>b.IsVerified==false).Count();
                      }
                      <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">UnVerified Businesses</h5>
                      <p class="font-normal text-gray-700 dark:text-gray-400">@(unVerifiedBusinesses > 1 ? $"{unVerifiedBusinesses} Businesses" : $"{unVerifiedBusinesses} Business")</p>
                    </a>
                  </dl>
              </div>
              <div class="hidden p-4 bg-white rounded-lg md:p-8 dark:bg-gray-800" id="about" role="tabpanel" aria-labelledby="about-tab">
                  <h2 class="mb-5 text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">Seals</h2>
                  <!-- List -->
                  <ul role="list" class="grid max-w-screen-xl grid-cols-1 gap-4 p-4 mx-auto text-gray-900 md:grid-cols-2 lg:grid-cols-3  dark:text-white sm:p-8">
                       <a href="#" class="block max-w-sm p-6 bg-green-300 border border-gray-200 rounded-lg shadow-sm hover:bg-green-600 hover:text-white dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
                          <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 hover:text-white  dark:text-white">Total Applied Seals</h5>
                          <p class="font-normal text-gray-700 hover:text-white  dark:text-gray-400">@(@Model.seals.Count() > 1 ? $"{@Model.businesses.Count()} Seals" : $"{@Model.seals.Count()} Seal")</p>
                        </a>

                        <a href="#" class="block max-w-sm p-6 bg-green-300 border border-gray-200 rounded-lg shadow-sm hover:bg-green-600 hover:text-white dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
                          @{
                            var validSeals = Model.seals.Where(s=>s.ExpiresAt >= DateTime.Now).Count();
                          }
                          <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 hover:text-white  dark:text-white">Valid Seals</h5>
                          <p class="font-normal text-gray-700 hover:text-white  dark:text-gray-400">@(validSeals > 1 ? $"{validSeals} Seals" : $"{validSeals} Seal")</p>
                        </a>

                        <a href="#" class="block max-w-sm p-6 bg-green-300 border border-gray-200 rounded-lg shadow-sm hover:bg-green-600 hover:text-white dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
                          @{
                            var inValidSeals = Model.seals.Where(s=>s.ExpiresAt < DateTime.Now).Count();
                          }
                          <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 hover:text-white  dark:text-white">Expired Seals</h5>
                          <p class="font-normal text-gray-700 hover:text-white  dark:text-gray-400">@(inValidSeals > 1 ? $"{inValidSeals} Seals" : $"{inValidSeals} Seal")</p>
                        </a>
                  </ul>
              </div>
          </div>
      </div>

      @* End of statistics *@
      @* Lower side bar *@
      <div class="container">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 p-2 sm:p-3">
          <div class="flex flex-col bg-white border border-gray-200 shadow-2xs rounded-xl p-4 md:p-5 dark:bg-neutral-900 dark:border-neutral-700 dark:shadow-neutral-700/70">
            <h3 class="text-lg font-bold text-gray-800 dark:text-white">
             Your Actions
            </h3>
            <div class="flex flex-col">
              <div class="-m-1.5 overflow-x-auto">
                <div class="p-1.5 min-w-full inline-block align-middle">
                  <div class="overflow-hidden">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-neutral-700">
                      <thead>
                        <tr>
                          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-500">Action</th>
                          <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase dark:text-neutral-500">Date</th>
                        </tr>
                      </thead>
                      <tbody>
                        @foreach(var not in Model.notifications)
                        {
                          <tr class="odd:bg-white even:bg-gray-100 hover:bg-gray-100 dark:odd:bg-neutral-800 dark:even:bg-neutral-700 dark:hover:bg-neutral-700">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800 dark:text-neutral-200">@not.Content</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800 dark:text-neutral-200">@not.CreatedAt.ToShortDateString()</td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- ... -->
          <div class="flex flex-col bg-white border border-gray-200 shadow-2xs rounded-xl p-4 md:p-5 dark:bg-neutral-900 dark:border-neutral-700 dark:shadow-neutral-700/70">
            <h3 class="text-lg font-bold text-gray-800 dark:text-white">
             Analytics
            </h3>
            @* Chart *@
            
              <canvas id="user-analytics-chart" width="400" height="200"></canvas>
            @* End of chart *@
          </div>
        </div>
      </div>
      @* End of lower sidebar *@
    </div>
    } else {
      <p>This <isindex> admin Dashboard</p>
    }
  }
}

@section Scripts{
<script>
  let vbusinesses = @vBusinesses;
  let ubusinesses = @unVBusinesses

  //
  const data = {
  labels: [
    'Verified',
    'Unverified',
  ],
  datasets: [{
    label: 'User Analytics',
    data: [vbusinesses,ubusinesses],
    backgroundColor: [
      'rgb(255, 99, 132)',
      'rgb(54, 162, 235)',
    ],
    hoverOffset: 4
  }]
};
  //
  console.log(vbusinesses,ubusinesses)
    window.addEventListener('DOMContentLoaded', () => {
  try {
    const canvas = document.getElementById('user-analytics-chart');
    console.log(canvas)

    new Chart(canvas, {
      type: 'doughnut',
      data: data
    });
  } catch (err) {
    console.error("Failed to create chart:", err.message);
  }
});

</script>
}
