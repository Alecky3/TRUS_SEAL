                                                                <input type="text" name="AttachmentConfig.ForWhichField" value="@config.ForWhichField" id="AttachmentConfig.ForWhichField" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white"  required />
                                                            </div>
                                                            <div>
                                                                <label for="AttachmentConfig.Required" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Required</label>
                                                                <select  id="AttachmentConfig.Required" name="AttachmentConfig.Required" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                                                    <option selected value="0">False</option>
                                                                    <option value="1">True</option>
                                                                </select>
                                                            </div>
                                                            <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
                                                                <button id="edit-attachmentconfig-submit-@config.Id"  type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Save</button>
                                                                <button data-modal-hide="edit-attachmentconfig-modal-@category.Id" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Cancel</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div> 
                                        @* Edit New Attachment Config Modal *@
                                       </div>
                                    </div>
                                }
                            }
                        </div>
                        
                    </form>
                    
                </div>
            </div>
            @* End Body *@
        }
    </div>
</section>

@section Scripts{
    <script>
        var addAttachmentForms =document.querySelectorAll("form[data-form^='attachment-config']");
        var addAttachmentBusinessInfoForm = document.querySelectorAll("form[data-form='attachment-config-business-information']")[0];
        var editAttchmentConfigSubmitBtn = document.querySelectorAll("button[id^='edit-attachmentconfig-submit']");
        console.log(editAttchmentConfigSubmitBtn);
        console.log(addAttachmentForms)
        addAttachmentForms.forEach(addAttachmentForms=>{
            addAttachmentForms.addEventListener("submit",handleCreateNewAttachmentConfig)
        })
        addAttachmentBusinessInfoForm.addEventListener("submit",handleCreateNewAttachmentConfig);

        editAttchmentConfigSubmitBtn.forEach(btn=>{
            btn.addEventListener("click",handleUpdateAttachmentConfig)
        })
        function handleCreateNewAttachmentConfig(e)
        {
            e.preventDefault();
                let form =e.target;
                let btn=form.querySelector("button[type='submit']");
                btn.disabled=true
                let formData = new FormData(form);
                const token = form.querySelector("input[name='__RequestVerificationToken']").value;
                fetch("/AttachmentConfig",{
                    method:"POST",
                     headers:{
                            RequestVerificationToken: token
                        },
                    body: formData
                }).then(res=>res.json())
                .then(jsonRes=>{
                     Swal.fire({
                        text: "Created Attachment Config successfuly",
                        toast: true,
                        position: "center",
                        timerProgressBar: true,
                        icon: "success",
                        timer: 1500,
                        showConfirmButton: false
                    })
                    btn.disabled=false;
                    console.log(jsonRes)
                }).catch(err=>{
                    Swal.fire({
                        text: "Error Creating attachement config",
                        toast: true,
                        position: "center",
                        timerProgressBar: true,
                        icon: "error",
                        timer: 1500,
                        showConfirmButton: false
                    })
                    btn.disabled=false;
                    console.error(err)
                })
        }

        function handleUpdateAttachmentConfig(e)
        {
            let btn =e.target;
            btn.disabled =true;
            let inputs  = e.target.parentElement.parentElement.querySelectorAll("input,select")
            let formData = new FormData();
            const token = document.querySelector("input[name='__RequestVerificationToken']").value;
            @* console.log(token); *@

            inputs.forEach(input=>{
                let nameAttr= input.getAttribute("name");
                let value=input.value
                formData.append(nameAttr,value)
            })
           fetch("/AttachmentConfig?handler=UpdateAttachmentConfig",{
            method:"POST",
                     headers:{
                            RequestVerificationToken: token
                        },
                    body: formData
           }).then(res=>res.json())
           .then(jsonRes=>{
             Swal.fire({
                text: "Updated Attachment Config successfuly",
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "success",
                timer: 1500,
                showConfirmButton: false
              })
            btn.disabled =false;
           }).catch(err=>{
            Swal.fire({
                text: "Error updating attachment-config config",
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "error",
                timer: 1500,
                showConfirmButton: false
              })
            btn.disabled =false;
           })
        }
    </script>
}