        function handleAddNewQuestionCategory(e)
        {
            e.preventDefault();
            var submitBtn=e.target.querySelector("button[type='submit']");
            submitBtn.disabled=true;
             submitBtn.innerHTML=`<span class="animate-spin inline-block size-4 border-[3px] border-current border-t-transparent text-white rounded-full" role="status" aria-label="loading"></span>
                            Saving...`
            let formData=new FormData(e.target);
            const token = e.target.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/TsQuestions?handler=AddNewCategory", {
            method: "POST",
            headers: {
                RequestVerificationToken: token
            },
            body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                console.log(jsonRes)
                Swal.fire({
                text: "Successfuly Created Question Category",
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "success",
                timer: 1500,
                showConfirmButton: false
              })
                submitBtn.innerHTML="Save"
                submitBtn.disabled=false;
                submitBtn.classList.toggle("hidden")
                window.location.reload()
