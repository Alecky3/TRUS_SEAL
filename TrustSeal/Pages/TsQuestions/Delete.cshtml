@page
@model TrustSeal.Pages.TsQuestions.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-2xl lg:py-16">
        <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Delete Question</h2>
        <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Are you sure you want to delete this?</h3>
        
        <div class="bg-gray-50 border border-gray-300 rounded-lg p-4 dark:bg-gray-800 dark:border-gray-600">
            <h4 class="text-lg font-medium text-gray-900 dark:text-white">Question Details</h4>
            <hr class="my-2 border-gray-300 dark:border-gray-600" />
            <dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
                <div>
                    <dt class="text-sm font-medium text-gray-900 dark:text-gray-200">
                        @Html.DisplayNameFor(model => model.Question.QuestionText)
                    </dt>
                    <dd class="mt-1 text-sm text-gray-700 dark:text-gray-400">
                        @Html.DisplayFor(model => model.Question.QuestionText)
                    </dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-900 dark:text-gray-200">
                        @Html.DisplayNameFor(model => model.Question.IsActive)
                    </dt>
                    <dd class="mt-1 text-sm text-gray-700 dark:text-gray-400">
                        @Html.DisplayFor(model => model.Question.IsActive)
                    </dd>
                </div>
                
                <div>
                    <dt class="text-sm font-medium text-gray-900 dark:text-gray-200">
                        @Html.DisplayNameFor(model => model.Question.Category)
                    </dt>
                    <dd class="mt-1 text-sm text-gray-700 dark:text-gray-400">
                        @Html.DisplayFor(model => model.Question.Category.Name)
                    </dd>
                </div>
            </dl>
        </div>
        
        <div class="mt-6 flex items-center space-x-4">
            <form method="post">
                <input type="hidden" asp-for="Question.Id" />
                <button type="submit" class="text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                    Delete
                </button>
            </form>
            <a asp-page="./Index" class="text-white bg-gray-800 hover:bg-gray-900 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-gray-800 dark:hover:bg-gray-700 dark:focus:ring-gray-700 dark:border-gray-700">
                Back to List
            </a>
        </div>
    </div>
</section>
