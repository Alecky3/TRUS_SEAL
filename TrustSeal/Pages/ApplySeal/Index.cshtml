@page
@model TrustSeal.Pages.ApplySeal.IndexModel
@{
}

<section class="bg-white dark:bg-gray-900">
    <div class="mx-auto px-6 lg:py-16">
        <ol id="stepper" class="flex items-center w-full mx-auto mb-4 sm:mb-5">
            <li id="step0" class="flex w-full items-center after:content-[''] after:w-full after:h-1 after:border-b after:border-gray-100 after:border-4 after:inline-block dark:after:border-gray-700" data-step-name="Business Information">
                <div class="flex flex-col items-center">
                    <div class="flex items-center justify-center w-10 h-10 bg-gray-100 rounded-full lg:h-12 lg:w-12 dark:bg-gray-700 shrink-0 mb-2">
                        <svg class="w-4 h-4 text-primary-600 lg:w-6 lg:h-6 dark:text-primary-300 question-mark" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                        <svg class="w-6 h-6 text-green-600 dark:text-green-300 check-mark hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div class="text-xs font-bold text-center w-20 overflow-hidden text-ellipsis">Select Business</div>
                </div>
           
            </li>
            @foreach (var (item, index) in Model.Criteria.Select((item, index) => (item, index)))
            {
                <li id="step@(index + 1)" class="flex w-full items-center @(index < Model.Criteria.Count() - 1 ? "after:content-[''] after:w-full after:h-1 after:border-b after:border-gray-100 after:border-4 after:inline-block dark:after:border-gray-700" : "")" data-step-name="@item.Name">
                    <div class="flex flex-col items-center">
                        <div class="flex items-center justify-center w-10 h-10 bg-gray-100 rounded-full lg:h-12 lg:w-12 dark:bg-gray-700 shrink-0 mb-2">
                            <svg class="w-4 h-4 text-primary-600 lg:w-6 lg:h-6 dark:text-primary-300 question-mark" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <svg class="w-6 h-6 text-green-600 dark:text-green-300 check-mark hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <div class="text-xs font-bold text-center w-20 overflow-hidden text-ellipsis">@item.Name</div>
                    </div>
                </li>
            }
        </ol>
        <h2 id="currentStepHeading" class="mb-4 text-xl font-bold text-gray-900 dark:text-white">
            e-Commerce Business Information
        </h2>
        <form method="post" id="createBusinessForm">

            <div id="step0Fields" class="step-fields">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-500"></div>
            <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
                <div class="sm:col-span-2">
                    <label asp-for="Business.LegalName" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Legal Name</label>
                    <input asp-for="Business.LegalName" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" required>
                    <span asp-validation-for="Business.LegalName" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.RegistrationNumber" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Registration Number</label>
                    <input asp-for="Business.RegistrationNumber" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.RegistrationNumber" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.TaxIdentificationNumber" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Tax ID</label>
                    <input asp-for="Business.TaxIdentificationNumber" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.TaxIdentificationNumber" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.IncorporationDate" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Incorporation Date</label>
                    <input asp-for="Business.IncorporationDate" type="date" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.IncorporationDate" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div class="sm:col-span-2">
                    <label asp-for="Business.StreetAddress" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Street Address</label>
                    <input asp-for="Business.StreetAddress" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.StreetAddress" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.City" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">City</label>
                    <input asp-for="Business.City" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.City" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.PostalCode" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Postal Code</label>
                    <input asp-for="Business.PostalCode" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.PostalCode" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.Country" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Country</label>
                    <input asp-for="Business.Country" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.Country" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.PhoneNumber" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Phone Number</label>
                    <input asp-for="Business.PhoneNumber" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.PhoneNumber" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.Email" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Email</label>
                    <input asp-for="Business.Email" type="email" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.Email" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.Website" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Website</label>
                    <input asp-for="Business.Website" type="url" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.Website" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.PrimaryContactName" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Primary Contact Name</label>
                    <input asp-for="Business.PrimaryContactName" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.PrimaryContactName" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.PrimaryContactPhone" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Primary Contact Phone</label>
                    <input asp-for="Business.PrimaryContactPhone" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.PrimaryContactPhone" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.PrimaryContactEmail" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Primary Contact Email</label>
                    <input asp-for="Business.PrimaryContactEmail" type="email" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                    <span asp-validation-for="Business.PrimaryContactEmail" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                    <label asp-for="Business.BusinessType" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Business Type</label>
                    <input asp-for="Business.BusinessType" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" />
                    <span asp-validation-for="Business.BusinessType" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>

                <div>
                    <label asp-for="Business.IndustryCategory" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Industry Category</label>
                    <input asp-for="Business.IndustryCategory" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" />
                    <span asp-validation-for="Business.IndustryCategory" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>



                <div>
                    <label asp-for="Business.SubmissionDate" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Submission Date</label>
                    <input asp-for="Business.SubmissionDate" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" />
                    <span asp-validation-for="Business.SubmissionDate" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>

                @*  <div class="sm:col-span-2">
                <label asp-for="Business.OwnerId" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Owner</label>
                <select asp-for="Business.OwnerId" asp-items="ViewBag.OwnerId" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"></select>
                <span asp-validation-for="Business.OwnerId" class="text-sm text-red-600 dark:text-red-500"></span>
                </div> *@
            </div>
           
            </div>
            @foreach (var (item, index) in Model.Criteria.Select((item, index) => (item, index)))
            {
                <div id="step@(index + 1)Fields" class="  flex  gap-4 step-fields">
                    @foreach (var question in @item.questions)
                    {
                        <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
                            <label for="question@(index + 1)_@(question.Id)" class="block  mb-2 w-full text-sm font-medium text-gray-900 dark:text-white">
                                @question.QuestionText
                            </label>
                            <input type="text" id="question@(index + 1)_@(question.Id)"
                                   name="Criteria[@index].Questions[@question.Id].QuestionText"
                                   class="bg-gray-50  w-full border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
                                   placeholder="Enter question text"
                                   value="@question.QuestionText"
                                   required>
                            <span data-valmsg-for="Criteria[@index].Questions[@question.Id].QuestionText" class="text-sm text-red-600 dark:text-red-500"></span>
                        </div>
                    }

                </div>
              
            }
         

            <br />
            <div class="flex flex-row-reverse space-x-4 space-x-reverse">
                <div>
                    <button type="button" id="nextButton" class="text-white bg-gray-800 hover:bg-gray-900 focus:ring-4 focus:outline-none focus:ring-gray-700 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                        Next Step: Payment Info
                    </button>
                </div>
                <div>
                    <button type="button" id="prevButton" class="justify-end text-white bg-gray-800 hover:bg-gray-900 focus:ring-4 focus:outline-none focus:ring-gray-700 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                        Previous
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const stepper = document.getElementById('stepper');
            const steps = stepper.getElementsByTagName('li');
            const nextButton = document.getElementById('nextButton');
            const prevButton = document.getElementById('prevButton');
            const form = document.getElementById('createBusinessForm');
            const stepFields = Array.from(document.querySelectorAll('[id^="step"][id$="Fields"]'));
            const currentStepHeading = document.getElementById('currentStepHeading');

            let currentStep = 0


            function updateButtonsVisibility() {
                prevButton.style.display = currentStep > 0 ? 'block' : 'none';
                nextButton.textContent = currentStep === steps.length - 1 ? 'Submit' : `Next Step: ${steps[currentStep + 1].getAttribute('data-step-name')}`;
            }


            function updateStepStyles(stepIndex, status) {
                const step = steps[stepIndex];
                const circle = step.querySelector('div > div');
                const questionMark = circle.querySelector('.question-mark');
                const checkMark = circle.querySelector('.check-mark');

                if (status === 'current') {
                    circle.classList.remove('bg-gray-100', 'dark:bg-gray-700', 'bg-green-100', 'dark:bg-green-800');
                    circle.classList.add('bg-primary-100', 'dark:bg-primary-800');
                    questionMark.classList.remove('hidden', 'text-gray-600', 'dark:text-gray-300');
                    questionMark.classList.add('text-primary-600', 'dark:text-primary-300');
                    checkMark.classList.add('hidden');
                    if (stepIndex > 0) {
                        steps[stepIndex - 1].classList.remove('after:border-gray-100', 'dark:after:border-gray-700');
                        steps[stepIndex - 1].classList.add('after:border-primary-100', 'dark:after:border-primary-800');
                    }
                } else if (status === 'completed') {
                    circle.classList.remove('bg-gray-100', 'dark:bg-gray-700', 'bg-primary-100', 'dark:bg-primary-800');
                    circle.classList.add('bg-green-100', 'dark:bg-green-800');
                    questionMark.classList.add('hidden');
                    checkMark.classList.remove('hidden');
                    if (step.classList.contains('after:content-[\'\']')) {
                        step.classList.remove('after:border-gray-100', 'dark:after:border-gray-700', 'after:border-primary-100', 'dark:after:border-primary-800');
                        step.classList.add('after:border-green-100', 'dark:after:border-green-800');
                    }
                } else {
                    circle.classList.add('bg-gray-100', 'dark:bg-gray-700');
                    circle.classList.remove('bg-primary-100', 'dark:bg-primary-800', 'bg-green-100', 'dark:bg-green-800');
                    questionMark.classList.remove('hidden', 'text-primary-600', 'dark:text-primary-300');
                    questionMark.classList.add('text-gray-600', 'dark:text-gray-300');
                    checkMark.classList.add('hidden');
                    if (step.classList.contains('after:content-[\'\']')) {
                        step.classList.remove('after:border-primary-100', 'dark:after:border-primary-800', 'after:border-green-100', 'dark:after:border-green-800');
                        step.classList.add('after:border-gray-100', 'dark:after:border-gray-700');
                    }
                }
            }

            function updateHeading(stepIndex) {
                const stepName = steps[stepIndex].getAttribute('data-step-name');
                currentStepHeading.textContent = stepName;
            }

            function showStep(stepIndex) {
                stepFields.forEach((field, index) => {
                    field.style.display = index === stepIndex ? 'grid' : 'none';
                });
                updateStepStyles(stepIndex, 'current');
                updateHeading(stepIndex);
            }

        

            nextButton.addEventListener('click', function () {
                if (currentStep < steps.length - 1) {
                    if (form.checkValidity()) {
                        updateStepStyles(currentStep, 'completed');
                        currentStep++;
                        showStep(currentStep);
                        updateButtonsVisibility();
                    } else {
                        form.reportValidity();
                    }
                } else {
                    form.submit();
                }
            });

            prevButton.addEventListener('click', function () {
                if (currentStep > 0) {
                    updateStepStyles(currentStep, 'incomplete');
                    currentStep--;
                    showStep(currentStep);
                    updateButtonsVisibility();
                }
            });

            showStep(0);
            updateButtonsVisibility();


            function showStep(stepIndex) {
                stepFields.forEach((field, index) => {
                    field.style.display = index === stepIndex ? 'block' : 'none';
                });
                updateStepStyles(stepIndex, 'current');
                updateHeading(stepIndex);
            }
        });
    </script>
}