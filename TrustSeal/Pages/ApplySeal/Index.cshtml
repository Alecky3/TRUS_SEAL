@page
@model TrustSeal.Pages.ApplySeal.IndexModel

@{

  ViewData["Title"] = "Apply Seal";
  var numOfCategories = Model.Criteria.Count();
  
}

<section class="bg-white dark:bg-gray-900">
    <div class="p-4 bg-white rounded-lg shadow-md dark:bg-neutral-800">
    
  </div>

</section>

@section Scripts {
    
    <script>
      var stepper;
      var windowURL = new URL(window.location.href);
      

      var forms = document.querySelectorAll("form#createBusiness");
      var criteriaForms = document.querySelectorAll("form.criteriaAnswer");
      var CaseNumberElem = document.getElementById("CaseNumber");
      var fileInputs = document.querySelectorAll("input[type='file']")
      let BusinessIdInput =  document.querySelector("input[name='Business.Id']")

      // initialy file inputs are disabled until a user submits a Business successfuly of BusinessAnswer
      

      // If business is already created
      if(BusinessIdInput.value !== '')
       {
        console.log("Business Input has value")
        let submitBtn = forms[0].querySelector("button[type='submit']");
        console.log(submitBtn)
        submitBtn.innerText = "Modify & Save";
        fileInputs.forEach(fileInput=>{
          fileInput.disabled = false;
        })
       } else {
        console.log("Busness input does not have a value",BusinessIdInput.value)
        console.log("File inputs should be disabled")
        fileInputs.forEach(fileInput=>{
          fileInput.disabled = true;
        })
       }
      console.log(criteriaForms);
      console.log(forms);
      console.log(CaseNumberElem)

      // Saving Business information
      forms.forEach(form=>{
        form.addEventListener("submit",(e)=>{
          event.preventDefault();
          console.log(e.target);
          var submitBtn = e.target.querySelector("button[type='submit']");
          console.log(submitBtn)
          submitBtn.innerText = "Saving Business Info...";
          submitBtn.disabled = true;
          let formData = new FormData(e.target);
          const token = document.querySelector("input[name='__RequestVerificationToken']").value;
          console.log(token)
          fetch("/ApplySeal?handler=NewBusiness",{
            method: "POST",
            headers:{
                RequestVerificationToken: token
            },
            body: formData
          })
          .then(res=> res.json())
          .then(messg => {
            console.log(messg);
            let message = messg;
            if (message.business)
            {
              if (message.business !== 0)
              {
               
               console.log(BusinessIdInput.value);
               BusinessIdInput.value = message.business;
               // enable next button
               if (stepper)
                {
                  stepper.enableButtons();
                }
               //enable file inputs
               fileInputs.forEach(fileInput=>{
                  fileInput.disabled = false;
                })
               // modify query string
               if (windowURL.searchParams.get("Id")){
                 windowURL.searchParams.set("Id",message.business);
                 history.replaceState(null,'',windowURL)
               }else {
                 windowURL.searchParams.append("Id",message.business);
                 history.replaceState(null,'',windowURL)
               }
              
               console.log(windowURL.toString())
               console.log(BusinessIdInput.value);
               submitBtn.innerText = "Saved Business";
               submitBtn.enabled = false;
              }
              else {
                submitBtn.innerText = "Save Progress";
                submitBtn.disabled = false;
              }
            }else {
              submitBtn.innerText = "Save Progress";
                submitBtn.disabled = false;
            }
           
          }).catch(err=>{
            console.log(err);
          })
        })
      })

      // BusinessAnswer
      criteriaForms.forEach(form=>{
        form.addEventListener("submit",(e)=>{
          event.preventDefault();
          console.log(e.target);
          var submitBtn = e.target.querySelector("button[type='submit']");
          console.log(submitBtn)
          submitBtn.innerText = "Saving Answers...";
          submitBtn.disabled = true;
          let formData = new FormData(e.target);
          let BusinessIdInput = document.querySelector("input[name='Business.Id']");
          formData.append("Business.Id",BusinessIdInput.value);
          const token = document.querySelector("input[name='__RequestVerificationToken']").value;
          console.log(token)
          fetch("/ApplySeal?handler=BusinessAnswer",{
            method: "POST",
            headers:{
                RequestVerificationToken: token
            },
            body: formData
          })
          .then(res=> res.json())
          .then(messg => {
            var msg = messg;
            console.log(messg);
            if (msg.message === "Saved Answers successfuly")
            {
              submitBtn.innerText = "Saved Answers";
              submitBtn.disabled = true;
            }
            else 
            {
              submitBtn.innerText = "Save Progress";
              submitBtn.disabled = false;
            }
            if (msg.caseNumber.length != 0)
            {
              CaseNumberElem.innerHTML = `
<p class="text-gray-500 dark:text-gray-400">Congratulations! You've sucessfully submited all the required information.Below is A case number you will use to track your Seal Application </p>
<p class="text-4xl font-semibold text-green-700 dark:text-white">${msg.caseNumber}</p>
<hr class="h-px my-8 bg-gray-200 border-0 dark:bg-gray-700">
<p class="text-gray-500 dark:text-gray-400">
  
<a href="ApplySeal/TrackSealApplication?handler=ById&Id=${BusinessIdInput.value}" class="inline-flex items-center justify-center p-5 text-base font-medium text-gray-50 rounded-lg bg-green-300 hover:text-white hover:bg-green-400 dark:text-gray-50 dark:bg-green-300 dark:hover:bg-green-400 dark:hover:text-white">                                            
    <span class="w-full">Click here to see status of your application</span>
    <svg class="w-4 h-4 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
    </svg>
</a> 

</p>
`
            }
          }).catch(err=>{
            console.log(err);
          })
        })
      })
      
      
    // File Uploads
    fileInputs.forEach((input)=>{
      input.addEventListener("change",(e)=>{
        let formData = new FormData();
        let fileInput = e.target;
        const token = document.querySelector("input[name='__RequestVerificationToken']").value;
        console.log(token)
        console.log(fileInput.files[0]);
        formData.append(fileInput.name,fileInput.files[0],fileInput.files[0].name);
        if (BusinessIdInput.value !== '')
        {
          formData.append("Business.Id",BusinessIdInput.value)
        }

        fetch(`/ApplySeal?handler=${fileInput.name}`,{
            method: "POST",
            headers:{
                RequestVerificationToken: token
            },
            body: formData
          }).then(res=> res.json())
            .then(jsonRes=>{
              let fileLink = document.querySelector(`a[data-name='${fileInput.name}']`)
              console.log(fileLink)
              fileLink.href = jsonRes.fileUrl;
              fileLink.innerText = jsonRes.fileDisplayName
              console.log(jsonRes)
            })

      })
    })

    // Functionality for changing disabled status of file inputs
    BusinessIdInput.addEventListener("change",(e)=>{
      let BusinessId = e.target.value;
      console.log("Business Id Changed")
      if (BusinessId !== '')
      {
        console.log("Business.Id changed")
        fileInputs.forEach(fileInput=>{
          fileInput.disabled = false;
        })
      } else {
        fileInputs.forEach(fileInput=>{
          fileInput.disabled = true;
        })
      }
    })

    // stepper actions
    /*window.addEventListener("load",(e=>{
        stepper = window.HSStepper.getInstance(document.getElementById("applSealStepper"));
        // Initially stepper next button is disbled
        if (stepper)
        {
          if (windowURL.searchParams.get("CurrentIndex"))
          {
            var hsStepper =document.getElementById("applSealStepper")
            @* hsStepper.setAttribute("data-hs-stepper",`{"currentIndex":${windowURL.searchParams.get("CurrentIndex")}}`);
            console.log(hsStepper.getAttribute("data-hs-stepper"))
            stepper.currentIndex = windowURL.searchParams.get("CurrentIndex") *@
          } else {
            stepper.currentIndex = '1'
          }
          if (BusinessIdInput.value == '')
            stepper.disableButtons();
            /**
            stepper.on("next",currentIndex=>{
            if (windowURL.searchParams.get("CurrentIndex")){
                 windowURL.searchParams.set("CurrentIndex",currentIndex);
                 history.replaceState(null,'',windowURL)
               }else {
                 windowURL.searchParams.append("CurrentIndex",currentIndex);
                 history.replaceState(null,'',windowURL)
               }
          })
          
        }
        console.log(stepper);
      }))
      */
    
    </script>
   
}




