@section Scripts {
  <script>
    var smartWizard;
    $(document).ready(function () {

      $('#bussinessRegistrationWizard').smartWizard({
        getContent: getCaseNumber,
        autoAdjustHeight: false,
        toolbar: {
          position: 'none'
        }
      })

      const validator = new window.JustValidate("#createBusiness")
      validator.onSuccess(event => {
        handleCreateBusiness();
      })
      let businessInputs = document.querySelectorAll("form#createBusiness input[type='text'], form#createBusiness input[type='email'], form#createBusiness input[type='date'],form#createBusiness input[type='datetime-local'],form#createBusiness input[type='url']");
      businessInputs.forEach((input, index) => {
        let idAttribute = input.getAttribute('id');

        if (idAttribute !== null) {
          validator.addField("#" + idAttribute, [
            {
              rule: 'required'
            }
          ])
        }
      })
      let businessFiles = document.querySelectorAll("#createBusiness input[type='file']")
      console.log("business file inputs")
      console.log(businessFiles);
      businessFiles.forEach(fileInput => {
        let idAttribute = fileInput.getAttribute("id");
        if (idAttribute) {
          let requiredAttr = fileInput.getAttribute('required');
          validator.addField('#' + idAttribute, [
            {
              rule: 'minFilesCount',
              value: requiredAttr !== null ? 1 : 0,
            },
            {
              rule:'maxFilesCount',
              value:1
            },
            {
              rule: 'files',
              value: {
                files: {
                minSize: 1000,
                maxSize: 25600000,
                types: ['image/apng', 'application/x-freearc', 'image/avif', 'application/x-bzip', 'application/x-bzip2', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/epub+zip', 'application/gzip', 'application/x-zip', 'image/gif', 'image/jpeg', 'image/png', 'application/pdf', 'application/vnd.ms-powerpoint', 'application/vnd.openxmlformats-officedocument.presentationml.presentation', 'application/vnd.rar', 'application/rtf', 'image/svg+xml', 'application/x-tar', 'image/tiff', 'image/webp', 'application/zip', 'application/x-zip-compressed']
                        }
                   }
                }
                ])
              }
            })

    // Business Answers Forms
    let bsAnswersForms = document.querySelectorAll("form[id^='QuestionAnswers']")
    bsAnswersForms.forEach(bsForm => {
      let idFormAttr = bsForm.getAttribute('id');
      if (idFormAttr) {
        let bsFormValidator = new window.JustValidate("#" + idFormAttr);
        bsFormValidator.onSuccess(event => {
          handlePostBusinessAnswers(event)
        })
        let bsFormInputs = document.querySelectorAll(`form#${idFormAttr} input[type='text'], form#${idFormAttr} input[type='email'], form#${idFormAttr} input[type='date'],form#${idFormAttr} input[type='datetime-local'],form#${idFormAttr} input[type='url']`);
        bsFormInputs.forEach(bsInput => {
          let idBsInput = bsInput.getAttribute("id");
          if (idBsInput) {
            bsFormValidator.addField("#" + idBsInput, [
              {
                rule: 'required'
              }
            ])
          }
        })
      }
    })    
          })
    var stepper;
    var windowURL = new URL(window.location.href);


    var forms = document.querySelectorAll("form#createBusiness");
    var criteriaForms = document.querySelectorAll("form.criteriaAnswer");
    var CaseNumberElem = document.getElementById("CaseNumber");
    var fileInputs = document.querySelectorAll("input[type='file']")
    let BusinessIdInput = document.querySelector("input[name='Business.Id']")

    // initialy file inputs are disabled until a user submits a Business successfuly of BusinessAnswer


    // If business is already created
    if (BusinessIdInput.value !== '') {
      console.log("Business Input has value")
      let submitBtn = forms[0].querySelector("button[type='submit']");
      console.log(submitBtn)
      submitBtn.innerText = "Modify & Save";
    } else {
      console.log("Busness input does not have a value", BusinessIdInput.value)
      console.log("File inputs should be disabled")
    }
    console.log(criteriaForms);
    console.log(forms);
    console.log(CaseNumberElem)

    // Saving Business information
    @* forms.forEach(form=>{
        form.addEventListener("submit",(e)=>{
          e.preventDefault();
          handleCreateBusiness()
        })
        }) *@
      /**handles creation of A new Business**/
      function handleCreateBusiness() {
    @* e.preventDefault();
          console.log(e.target);
          var submitBtn = e.target.querySelector("button[type='submit']"); 
          @* console.log(submitBtn) 
          submitBtn.innerText = "Saving Business Info...";
          @* submitBtn.disabled = true; *@
             var businessInfoForm = document.querySelector("#createBusiness");
        let formData = new FormData(businessInfoForm);

        if (BusinessIdInput.value !== '' && BusinessIdInput.value !== undefined) {
          formData.append("Business.Id", BusinessIdInput.value);
        }
        const token = document.querySelector("input[name='__RequestVerificationToken']").value;
        console.log(token)

        fetch(BusinessIdInput.value ? "/ApplySeal?handler=UpdateBusiness" : "/ApplySeal?handler=NewBusiness", {
          method: "POST",
          headers: {
            RequestVerificationToken: token
          },
          body: formData
        })
          .then(res => res.json())
          .then(messg => {
            console.log(messg);
            let message = messg;
            if (message.business !== undefined) {
              if (message.business !== 0) {

                console.log(BusinessIdInput.value);
                BusinessIdInput.value = message.business;

                // modify query string
                if (windowURL.searchParams.get("Id")) {
                  windowURL.searchParams.set("Id", message.business);
                  history.replaceState(null, '', windowURL)
                } else {
                  windowURL.searchParams.append("Id", message.business);
                  history.replaceState(null, '', windowURL)
                }

                console.log(windowURL.toString())
                console.log(BusinessIdInput.value);
                Swal.fire({
                  text: message.message,
                  toast: true,
                  position: "center",
                  timerProgressBar: true,
                  icon: "success",
                  timer: 1500,
                  showConfirmButton: false
                }).then(result => {
                  $('#bussinessRegistrationWizard').smartWizard("next")
                })
              }
              else {
                console.log("could not Save business")
                Swal.fire({
                  text: "Could not Update business Information",
                  toast: true,
                  position: "center",
                  timerProgressBar: true,
                  icon: "info",
                  timer: 1500,
                  showConfirmButton: false
                })
              }
            } else {
              console.log("could not Save Business Information")
              Swal.fire({
                text: "Could not Save business Information",
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "error",
                timer: 1500,
                showConfirmButton: false
              })
            }

          }).catch(err => {
            console.log(err);
          })
      }



    // BusinessAnswer
    @* criteriaForms.forEach(form=>{
        form.addEventListener("submit",(e)=>{

      }) *@
      //Business Answers submit button
      function handlePostBusinessAnswers(e) {
        event.preventDefault();
        console.log(e.target);
        var submitBtn = e.target.querySelector("button[type='submit']");
        console.log(submitBtn)
        submitBtn.innerText = "Saving Answers...";
        submitBtn.disabled = true;
        var bsAnswerInput = event.target.querySelector("input[name$='AnswerId']");
        console.log(bsAnswerInput)
        let formData = new FormData(e.target);
        let BusinessIdInput = document.querySelector("input[name='Business.Id']");
        console.log(BusinessIdInput)
        formData.append("Business.Id", BusinessIdInput.value);
        const token = document.querySelector("input[name='__RequestVerificationToken']").value;
        console.log(token)
        fetch(bsAnswerInput ? "/ApplySeal?handler=UpdateBusinessAnswer" : "/ApplySeal?handler=BusinessAnswer", {
          method: "POST",
          headers: {
            RequestVerificationToken: token
          },
          body: formData
        })
          .then(res => res.json())
          .then(messg => {
            var msg = messg;
            console.log(messg);
            if (msg.message) {
              Swal.fire({
                text: msg.message,
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "success",
                timer: 1500,
                showConfirmButton: false
              }).then(result => {
                $('#bussinessRegistrationWizard').smartWizard("next")
              })
              submitBtn.innerText = "Saved Answers";
              submitBtn.disabled = false;
            }
            else {
              Swal.fire({
                text: "Unable to Save Answers",
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "error",
                timer: 1500,
                showConfirmButton: false
              })
              submitBtn.innerText = "Save Progress";
              submitBtn.disabled = false;
            }
          }).catch(err => {
            Swal.fire({
              text: "Unable to Save Answers",
              toast: true,
              position: "center",
              timerProgressBar: true,
              icon: "success",
              timer: 1500,
              showConfirmButton: false
            })
            console.log(err);
            submitBtn.disabled = false;
          })
      }

    // File Uploads
    fileInputs.forEach((input) => {
      input.addEventListener("change", (e) => {
        let formData = new FormData();
        let fileInput = e.target;
        let businessAttachmentInput = fileInput.nextElementSibling;
        console.log(businessAttachmentInput);
        const token = document.querySelector("input[name='__RequestVerificationToken']").value;
        console.log(token)
        console.log(fileInput.files[0]);
        formData.append(fileInput.getAttribute("id"), fileInput.files[0], fileInput.files[0].name);
        @* if (BusinessIdInput.value !== '') {
          formData.append("Business.Id", BusinessIdInput.value)
        } *@

        fetch(`/ApplySeal?handler=BusinessFiles`, {
          method: "POST",
          headers: {
            RequestVerificationToken: token
