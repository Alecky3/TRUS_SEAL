                    let formData = new FormData(form);
                    console.log(form,token,formData);

                    fetch("/ApplySeal?handler=FileUploadsWithFile",{
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                    },
                    body: formData
                   }).then(res => res.json()).
                   then(json=>{
                    console.log(`uploaded filename ${json.filename}`)
                    uploadedFilenameInput.value = json.filename;
                    console.log(uploadedFilenameInput.value);
                    console.log(json);
                   })
                   .catch(err=>{
                    console.log(err)
                   })
                })
             })
