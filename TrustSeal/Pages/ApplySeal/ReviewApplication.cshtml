@section Scripts {
  <script>
    var smartWizard;
    $(document).ready(function () {

      $('#bussinessRegistrationWizard').smartWizard({
        getContent: getCaseNumber,
        autoAdjustHeight: false,
        toolbar: {
          position: 'bottom'
        }
      })

    var stepper;
    var windowURL = new URL(window.location.href);

    let BusinessIdInput = document.querySelector("input[name='Business.Id']")

    function getCaseNumber(stepIndex, stepDirection, stepPosition, selStep, callback) {
        console.log(stepPosition + stepDirection)
        if (stepPosition == "last") {
          $.ajax({
            method: "GET",
            url: `/ApplySeal?Id=${BusinessIdInput.value}&handler=CaseNumber`,
            beforeSend: function (xhr) {
              $("#bussinessRegistrationWizard").smartWizard("loader", "show")
            }
          }).done(function (res) {
            console.log(res);
            let mess = res;
            if (mess.message) {
              if (mess.caseNumber) {
                let html = `
                              <p class="text-gray-500 dark:text-gray-400">Congratulations! You've sucessfully submited all the required information.Below is A case number you will use to track your Seal Application </p>
                              <p class="text-4xl font-semibold text-green-700 dark:text-white">${mess.caseNumber}</p>
                              <hr class="h-px my-8 bg-gray-200 border-0 dark:bg-gray-700">
                              <p class="text-gray-500 dark:text-gray-400">
                              <a href="/ApplySeal/TrackSealApplication?handler=ById&Id=${BusinessIdInput.value}" class="inline-flex items-center justify-center p-5 text-base font-medium text-gray-50 rounded-lg bg-green-300 hover:text-white hover:bg-green-400 dark:text-gray-50 dark:bg-green-300 dark:hover:bg-green-400 dark:hover:text-white">                                            
                                  <span class="w-full">Click here to see status of your application</span>
                                  <svg class="w-4 h-4 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
                                  </svg>
                              </a> 
                              </p>
                          `
                callback(html);
                $("#bussinessRegistrationWizard").smartWizard("loader", "hide")
              } else {
                let html = `<div class="p-1 md:p-4  bg-gray-50 flex justify-center items-center border border-dashed border-gray-200 rounded-xl dark:bg-neutral-700 dark:border-neutral-600">
                              <p class="text-gray-500 dark:text-gray-400">${mess.message}</p>
                          </div>`
                callback(html);
                $("#bussinessRegistrationWizard").smartWizard("loader", "hide")
              }
            } else {
              let html = `<div class="p-1 md:p-4  bg-gray-50 flex justify-center items-center border border-dashed border-gray-200 rounded-xl dark:bg-neutral-700 dark:border-neutral-600">
                              <p class="text-gray-500 dark:text-gray-400">${mess.error}</p>
                          </div>`
              callback(html);
              $("#bussinessRegistrationWizard").smartWizard("loader", "hide")
            }
          })
            .fail(function (err) {
              let html = `<div class="p-1 md:p-4  bg-gray-50 flex justify-center items-center border border-dashed border-gray-200 rounded-xl dark:bg-neutral-700 dark:border-neutral-600">
                              <p class="text-gray-500 dark:text-gray-400">An error occured, Please Review Your Application</p>
                          </div>`
              callback(html);
              $("#bussinessRegistrationWizard").smartWizard("loader", "hide")
            })
        }
        callback();
      }
  })
  </script>

}
