@page
@model TrustSeal.Pages.ApplySeal.ReviewApplication

@{

  ViewData["Title"] = "Apply Seal";
  var numOfCategories = Model.Criteria.Count();

}

<section class="bg-white dark:bg-gray-900">
  <div class="bg-white rounded-lg shadow-md dark:bg-neutral-800">
    <div id="bussinessRegistrationWizard">
      <ul class="nav">
        <li class="nav-item">
          <a href="#businessInformation" class="nav-link">Business Information</a>
        </li>
        @foreach (var (criteria, index) in Model.Criteria.Select((criteria, index) => (criteria, index + 1)))
        {
          <li class="nav-item">
            <a href="#step-@index" class="nav-link">@criteria.Name</a>
          </li>
        }
        <li class="nav-item">
          <a href="#caseNumber" class="nav-link">Finish</a>
        </li>
      </ul>
      @if (Model.Business != null)
      {
        <div class="tab-content" style="height: 100%;">
          <!-- Business Information-->
          <div id="businessInformation" class="tab-pane" role="tabpanel" aria-labelledby="businessInformation">
            <input asp-for="Business.Id" hidden>
            @*Register a new Business*@
            <form method="post" enctype="multipart/form-data" novalidate id="createBusiness" class="w-full">
              <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-500"></div>
              <div class="grid gap-4 md:grid-cols-2 sm:gap-2 md:gap-4">
                <div class="sm:col-span-2">
                  <label asp-for="Business.LegalName"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Legal Name</label>
                  <input asp-for="Business.LegalName"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.LegalName" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.RegistrationNumber"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Registration Number</label>
                  <input asp-for="Business.RegistrationNumber"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.RegistrationNumber"
                    class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.TaxIdentificationNumber"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Tax ID</label>
                  <input asp-for="Business.TaxIdentificationNumber"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.TaxIdentificationNumber"
                    class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.IncorporationDate"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Incorporation Date</label>
                  <input asp-for="Business.IncorporationDate" type="date"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.IncorporationDate"
                    class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div class="sm:col-span-2">
                  <label asp-for="Business.StreetAddress"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Street Address</label>
                  <input asp-for="Business.StreetAddress"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.StreetAddress" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.City"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">City</label>
                  <input asp-for="Business.City"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.City" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.PostalCode"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Postal Code</label>
                  <input asp-for="Business.PostalCode"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.PostalCode" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.Country"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">County</label>
                  <input asp-for="Business.Country"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.Country" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.PhoneNumber"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Phone Number</label>
                  <input asp-for="Business.PhoneNumber"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.PhoneNumber" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.Email"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Email</label>
                  <input asp-for="Business.Email" type="email"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.Email" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.Website"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Website</label>
                  <input asp-for="Business.Website" type="url"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.Website" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.PrimaryContactName"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Primary Contact Name</label>
                  <input asp-for="Business.PrimaryContactName"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.PrimaryContactName"
                    class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.PrimaryContactPhone"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Primary Contact Phone</label>
                  <input asp-for="Business.PrimaryContactPhone"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.PrimaryContactPhone"
                    class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.PrimaryContactEmail"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Primary Contact Email</label>
                  <input asp-for="Business.PrimaryContactEmail" type="email"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500">
                  <span asp-validation-for="Business.PrimaryContactEmail"
                    class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>
                  <label asp-for="Business.BusinessType"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Business Type</label>
                  <input asp-for="Business.BusinessType"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" />
                  <span asp-validation-for="Business.BusinessType" class="text-sm text-red-600 dark:text-red-500"></span>
                </div>

                <div>
                  <label asp-for="Business.IndustryCategory"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Industry Category</label>
                  <input asp-for="Business.IndustryCategory"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" />
                  <span asp-validation-for="Business.IndustryCategory"
                    class="text-sm text-red-600 dark:text-red-500"></span>
                </div>

                <div>
                  <label asp-for="Business.SubmissionDate"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Submission Date</label>
                  <input asp-for="Business.SubmissionDate"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" />
                  <span asp-validation-for="Business.SubmissionDate"
                    class="text-sm text-red-600 dark:text-red-500"></span>
                </div>
                <div>

                </div>
              </div>
              @* Business Attachments *@
              <div class="grid grid-cols-1 md:grid-cols-2 gap-2 gap-4">
                @foreach (var file in Model.AttachmentConfigs)
                {
                  if (file.Category == "Business Information")
                  {
                  List<string>attachedFiles = new List<string>();
                   @foreach(var attachments in Model.BusinessAttachments)
                   {
                    var fileConfig = file.ForWhichField.Replace(' ','_');
                    if(fileConfig == attachments.ForWhichField)
                    {
                      attachedFiles.Add(file.ForWhichField);
                      <div>
                        <p class="text-gray-500 dark:text-gray-400">Uploaded - <span class="mr-4"></span>@file.ForWhichField <span class="mr-4"></span><a href="/ApplySeal?handler=UploadedFile&Id=@attachments.Id" class="font-medium text-blue-600 underline dark:text-blue-500 hover:no-underline">@attachments.DisplayName</a> </p>
                      </div>
                    }
                   }
                   if(!attachedFiles.Contains(file.ForWhichField))
                   {
                    <div>
                      <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                        for="@(file.ForWhichField.Replace(' ','_'))">@file.ForWhichField</label>
                      <input
                        class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400"
                        id="@(file.ForWhichField.Replace(' ','_'))" type="file" @(file.Required ? "required":null)>
                      <input type="text" name="@(file.ForWhichField.Replace(' ','_'))_attachment" value="" hidden>
                    </div>
                   }
                  }
                }
              </div>
              @* End of Business Attachments *@
              @* <div class="mt-2">
                <button type="submit"
                  class="justify-end text-white bg-gray-800 hover:bg-gray-900 focus:ring-4 focus:outline-none focus:ring-gray-700 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                  Save Progress
                </button>
              </div> *@
            </form>
            @*End of Register a new Business*@

          </div>
          <!-- Business Information-->
          @if (Model.SubmittedAnswers.Count() != 0)
          {

            <!-- #region -->
            @foreach (var (item, index) in Model.Criteria.Select((item, index) => (item, index + 2)))
            {
              <div id="step-@index" role="tabpanel" class="tab-pane" aria-labelledby="step-@index">
                <div
                  class="p-4 w-full bg-gray-50 flex justify-center items-center border border-dashed border-gray-200 rounded-xl dark:bg-neutral-700 dark:border-neutral-600">
                  <div class="grid w-full gap-x-4 md:gap-x-6">
                    <form class="criteriaAnswer" id="QuestionAnswers_@index">
                      <input hidden name="category" value="@item.Name">
                      <input hidden name="isNextToFinal" value="@(index -1 == numOfCategories ? "true" : "false")">
                      @foreach (var question in @item.questions)
                      {

                        var questionAnswer = Model.SubmittedAnswers.Where(a => a.QuestionID == @question.Id).FirstOrDefault();
                        @* <span>@question.Id -- @questionAnswer.QuestionID</span> *@

                        <div>
                          <input hidden name="question_id_@question.Id" value="@question.Id">
                          <div>
                            <label for="question_id_@(question.Id)_AnswerText"
                              class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">@question.QuestionText</label>
                            @if (questionAnswer != null)
                            {
                              <input hidden name="question_id_@(question.Id)_AnswerId" value="@questionAnswer.Id" />
                              if(question.HasChoices & question.Choices != null)
                              {
                                <select  name="question_id_@(question.Id)_AnswerText"
                                id="question_id_@(question.Id)_AnswerText" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                  @foreach(var choice in question.Choices)
                                  {
                                    if(choice == questionAnswer.AnswerText)
                                    {
                                      <option selected value="@choice">@choice</option>
                                    } else {
                                      <option value="@choice">@choice</option>
                                    }

                                  }
                              </select>
                              } else {
                                <input type="text" name="question_id_@(question.Id)_AnswerText"
                                id="question_id_@(question.Id)_AnswerText" value="@questionAnswer.AnswerText"
                                class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" />
                              }

                            }
                            else
                            {
                              <input type="text" name="question_id_@(question.Id)_AnswerText"
                                id="question_id_@(question.Id)_AnswerText"
                                class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" />
                            }
                            <span asp-validation-for="@question.QuestionText"
                              class="text-sm text-red-600 dark:text-red-500"></span>
                          </div>
                        </div>
                      }
                      @* Question  Attachments *@
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 gap-4">
                        @foreach (var file in Model.AttachmentConfigs)
                        {
                          if (file.Category == item.Name)
                          {
                          List<string>attachedFiles = new List<string>();
                          @foreach(var attachments in Model.BusinessAttachments)
                          {
                            var fileConfig = file.ForWhichField.Replace(' ','_');
                            if(fileConfig == attachments.ForWhichField)
                            {
                              attachedFiles.Add(file.ForWhichField);
                              <div>
                                <p class="text-gray-500 dark:text-gray-400">Uploaded - <span class="mr-4"></span>@file.ForWhichField <span class="mr-4"></span><a href="/ApplySeal?handler=UploadedFile&Id=@attachments.Id" class="font-medium text-blue-600 underline dark:text-blue-500 hover:no-underline">@attachments.DisplayName</a> </p>
                              </div>
                            }
                          }
                          if(!attachedFiles.Contains(file.ForWhichField))
                          {
                            <div>
                              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                                for="@(file.ForWhichField.Replace(' ','_'))">@file.ForWhichField</label>
                              <input
                                class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400"
                                id="@(file.ForWhichField.Replace(' ','_'))" type="file" @(file.Required ? "required":null)>
                              <input type="text" name="@(file.ForWhichField.Replace(' ','_'))_attachment" value="" hidden>
                            </div>
                          }
                          }
                        }
                      </div>
                      @* End of Question Attachments *@
                      @* <div class="mt-2">
                        <button type="submit"
                          class="justify-end text-white bg-gray-800 hover:bg-gray-900 focus:ring-4 focus:outline-none focus:ring-gray-700 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                          Save Progress
                        </button>
                      </div> *@
                    </form>
                  </div>
                </div>
              </div>
            }
            <!-- End #region -->

          }
          else
          {
            @foreach (var (item, index) in Model.Criteria.Select((item, index) => (item, index + 2)))
            {
              <div id="step-@index" role="tabpanel" class="tab-pane" aria-labelledby="step-@index">
                <div
                  class="p-4 w-full bg-gray-50 flex justify-center items-center border border-dashed border-gray-200 rounded-xl dark:bg-neutral-700 dark:border-neutral-600">
                  <div class="grid w-full gap-x-4 md:gap-x-6">
                    <form class="criteriaAnswer" id="QuestionAnswers_@index">
                      <input hidden name="category" value="@item.Name">
                      <input hidden name="isNextToFinal" value="@(index -1 == numOfCategories ? "true" : "false")">
                      @foreach (var question in @item.questions)
                      {
                        <div>
                          <input hidden name="question_id_@question.Id" value="@question.Id">
                          <div>
                            <label for="question_id_@(question.Id)_AnswerText"
                              class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">@question.QuestionText</label>
                            <input type="text" name="question_id_@(question.Id)_AnswerText"
                              id="question_id_@(question.Id)_AnswerText"
                              class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" />
                            <span asp-validation-for="@question.QuestionText"
                              class="text-sm text-red-600 dark:text-red-500"></span>
                          </div>
                        </div>
                      }
                      @* Question  Attachments *@
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 gap-4">
                        @foreach (var file in Model.AttachmentConfigs)
                        {
                          if (file.Category == item.Name)
                          {
                          List<string>attachedFiles = new List<string>();
                          @foreach(var attachments in Model.BusinessAttachments)
                          {
                            var fileConfig = file.ForWhichField.Replace(' ','_');
                            if(fileConfig == attachments.ForWhichField)
                            {
                              attachedFiles.Add(file.ForWhichField);
                              <div>
                                <p class="text-gray-500 dark:text-gray-400">Uploaded - <span class="mr-4"></span>@file.ForWhichField <span class="mr-4"></span><a href="/ApplySeal?handler=UploadedFile&Id=@attachments.Id" class="font-medium text-blue-600 underline dark:text-blue-500 hover:no-underline">@attachments.DisplayName</a> </p>
                              </div>
                            }
                          }
                          if(!attachedFiles.Contains(file.ForWhichField))
                          {
                            <div>
                              <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                                for="@(file.ForWhichField.Replace(' ','_'))">@file.ForWhichField</label>
                              <input
                                class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400"
                                id="@(file.ForWhichField.Replace(' ','_'))" type="file" @(file.Required ? "required":null)>
                              <input type="text" name="@(file.ForWhichField.Replace(' ','_'))_attachment" value="" hidden>
                            </div>
                          }
                          }
                        }
                      </div>
                      @* End of Question Attachments *@
                      @* <div class="mt-2">
                        <button type="submit"
                          class="justify-end text-white bg-gray-800 hover:bg-gray-900 focus:ring-4 focus:outline-none focus:ring-gray-700 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                          Save Progress
                        </button>
                      </div> *@
                    </form>
                  </div>
                </div>
              </div>
            }
          }
          <!-- CaseNumber Number Generation -->
          <div id="caseNumber" class="tab-pane" role="tabpanel" aria-labelledby="caseNumber">
          </div>
          <!-- end of  CaseNumber Number Generation -->
        </div>
      }
      else
      {
        <!--Tab Contents-->
        <div class="tab-content" style="height: 100%;">
          <!-- Business Information-->
          <div id="businessInformation" class="tab-pane" role="tabpanel" aria-labelledby="businessInformation">
            <input asp-for="Business.Id" hidden>
            @*Register a new Business*@
            <form method="post" enctype="multipart/form-data" novalidate id="createBusiness" class="w-full">
              <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-500"></div>
              <div class="grid gap-4 md:grid-cols-2 sm:gap-2 md:gap-4">
                <div class="sm:col-span-2">
                  <label asp-for="Business.LegalName"
                    class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Legal Name</label>
