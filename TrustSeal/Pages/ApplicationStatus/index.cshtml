@page
@model TrustSeal.Pages.ApplicationStatus.IndexModel

<section>
    <section>
    <div id="accordion-open" data-accordion="open">
        @* Application Status Configs *@

        @* HEADER *@
            <h2 id="accordion-application-status">
                <button type="button" class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border border-b-0 border-gray-200 rounded-t-xl focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-800 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3" data-accordion-target="#accordion-body-application-status" aria-expanded="true" aria-controls="accordion-body-application-status">
                <span class="flex items-center"><svg class="w-5 h-5 me-2 shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path></svg>Business Verification Status Configs</span>
                <svg data-accordion-icon class="w-3 h-3 rotate-180 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5 5 1 1 5"/>
                </svg>
                </button>
            </h2>
            @* End Header *@
             @* Body *@
            <div id="accordion-body-application-status" class="hidden" aria-labelledby="accordion-application-status">
                <div class="p-5 border border-b-0 border-gray-200 dark:border-gray-700 dark:bg-gray-900">
                    <div class="flex justify-end">
                        <button data-modal-target="add-applicationstatus-modal-application-status" data-modal-toggle="add-applicationstatus-modal-application-status" type="button" class="px-3 py-2 text-xs font-medium text-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Add Config</button>
                    </div>
                    @* Add New Application Status Config Modal *@
                    <div id="add-applicationstatus-modal-application-status" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] max-h-full">
                        <div class="relative p-4 w-full max-w-md max-h-full">
                            <!-- Modal content -->
                            <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
                                <!-- Modal header -->
                                <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
                                    <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                                        Create New Application Status Config
                                    </h3>
                                    <button type="button" class="end-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="add-applicationstatus-modal-application-status">
                                        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                                        </svg>
                                        <span class="sr-only">Close modal</span>
                                    </button>
                                </div>
                                <!-- Modal body -->
                                <div class="p-4 md:p-5">
                                    <form data-form="new-applicationstatus-config" class="space-y-4" method="POST">
                                        <input type="text" name="applicationstatus.IsMain" value="True" hidden>
                                        <div>
                                            <label for="applicationstatus.Status" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Status Name</label>
                                            <input type="text" name="applicationstatus.Status" id="applicationstatus.Status" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white"  required />
                                        </div>
                                        <div>
                                            <label for="applicationstatus.Required" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Required</label>
                                            <select  id="applicationstatus.Required" name="applicationstatus.Required" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                                <option selected value="False">False</option>
                                                <option value="True">True</option>
                                            </select>
                                        </div>
                                        <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
                                            <button  type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Save</button>
                                            <button data-modal-hide="add-applicationstatus-modal-application-status" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Cancel</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div> 
                    @* End Add New application Status Config Modal *@
                    @* Application Status List *@
                    <section>
                        @foreach(var status in Model.ApplicationStatus)
                        {
                            <form id="application-status-form-@status.Id" method="post">
                                <input type="text" name="applicationStatus.Id" value="@status.Id" hidden>
                                <div class="grid md:grid-cols-5 gap-3">
                                    <div class="md:col-span-3">
                                        <label for="applicationStatus.Status" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Status Description</label>
                                        <input type="text" id="applicationStatus.Status-@status.Id" name="applicationStatus.Status" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" value="@status.Status"/>
                                    </div>
                                    <div>
                                        <label for="applicationStatus.Required" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Required</label>
                                            <select id="applicationStatus.Required-@status.Id" name="applicationStatus.Required" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                                @if(status.Required)
                                                {
                                                    <option value="@status.Required" selected>Required</option>
                                                    <option value="False">Not Required</option>
                                                } else {
                                                    <option value="True">Required</option>
                                                    <option value="@status.Required" selected>Not Required</option>
                                                }
                                            </select>
                                    </div>
                                    <div>
                                        <label for="applicationStatus.Order" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Order</label>
                                        <input type="number" id="applicationStatus.Order-@status.Id" name="applicationStatus.Order" required aria-describedby="helper-text-explanation" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" value="@status.Order"/>
                                    </div>
                                    <div>
                                    <button  type="submit" class="hidden text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Save</button>
                                    </div>
                                </div>
                            </form>
                
                        }
                    </section>
                    @* End of Application Status List *@
                </div>
            </div>
            @* End Body *@
        @* End Of Application Status Information  Configs *@
    </div>
</section>

@section Scripts {
    <script>
        var addNewStatusForm = document.querySelectorAll("form[data-form='new-applicationstatus-config']")[0];
        var applicationStatusForms=document.querySelectorAll("form[id^='application-status-form']");
        var applicationStatusFormInputs=document.querySelectorAll("form input[id^='applicationStatus']");
        var applicationStatusFormSelects=document.querySelectorAll("form select[id^='applicationStatus']");
       
        
        addNewStatusForm.addEventListener("submit",handleAddNewStatus)

        applicationStatusForms.forEach(form=>{
            form.addEventListener("submit",handleUpdateApplicationStatus)
        })

        applicationStatusFormInputs.forEach(formInput=>{
            
            formInput.addEventListener("change",handleFormInputsChange)
        })

        applicationStatusFormSelects.forEach(selectInput=>{
            
            selectInput.addEventListener("change",handleFormInputsChange)
        })

        function handleAddNewStatus(e)
        {
            e.preventDefault();
            var submitBtn=e.target.querySelector("button[type='submit']");
            submitBtn.disabled=true;
             submitBtn.innerHTML=`<span class="animate-spin inline-block size-4 border-[3px] border-current border-t-transparent text-white rounded-full" role="status" aria-label="loading"></span>
                            Saving...`
            let formData=new FormData(e.target);
            const token = e.target.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/ApplicationStatus?handler=AddNewStatus", {
            method: "POST",
            headers: {
                RequestVerificationToken: token
            },
            body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                console.log(jsonRes)
                Swal.fire({
                text: "Successfuly created Application Status",
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "success",
                timer: 1500,
                showConfirmButton: false
              })
                submitBtn.innerHTML="Save"
                submitBtn.disabled=false;
            }).catch(err=>{
                Swal.fire({
                text: "Error Creating Application Status",
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "error",
                timer: 1500,
                showConfirmButton: false
              })
                console.log(err)
                submitBtn.disabled=false;
                submitBtn.innerHTML="Save"
            })
           
        }

        function handleUpdateApplicationStatus(e)
        {
           e.preventDefault();
            var submitBtn=e.target.querySelector("button[type='submit']");
            submitBtn.disabled=true;
             submitBtn.innerHTML=`<span class="animate-spin inline-block size-4 border-[3px] border-current border-t-transparent text-white rounded-full" role="status" aria-label="loading"></span>
                            Saving...`
            let formData=new FormData(e.target);
            const token = e.target.querySelector("input[name='__RequestVerificationToken']").value;
            fetch("/ApplicationStatus?handler=UpdateStatus", {
            method: "POST",
            headers: {
                RequestVerificationToken: token
            },
            body: formData
            }).then(res=>res.json())
            .then(jsonRes=>{
                console.log(jsonRes)
                Swal.fire({
                text: "Successfuly Update Application Status",
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "success",
                timer: 1500,
                showConfirmButton: false
              })
                submitBtn.innerHTML="Save"
                submitBtn.disabled=false;
                submitBtn.classList.toggle("hidden")
            }).catch(err=>{
                Swal.fire({
                text: "Error Creating Application Status",
                toast: true,
                position: "center",
                timerProgressBar: true,
                icon: "error",
                timer: 1500,
                showConfirmButton: false
              })
                console.log(err)
                submitBtn.disabled=false;
                submitBtn.innerHTML="Save"
            })
        }

        function handleFormInputsChange(e)
        {
            console.log("input change")
            let submitBtn = e.target.parentElement.parentElement.querySelector("button[type='submit']")
            let hiddenClasslist=submitBtn.classList.contains("hidden")
            if(hiddenClasslist)
            {
                submitBtn.classList.toggle("hidden");
            }
        }
    </script>
}