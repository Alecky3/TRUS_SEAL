@page
@model TrustSeal.Pages.TsBusinessAnswers.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>BsAnswer</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BsAnswer.ID" />
            <div class="form-group">
                <label asp-for="BsAnswer.BusinessID" class="control-label"></label>
                <select asp-for="BsAnswer.BusinessID" class="form-control" asp-items="ViewBag.BusinessID"></select>
                <span asp-validation-for="BsAnswer.BusinessID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BsAnswer.QuestionID" class="control-label"></label>
                <select asp-for="BsAnswer.QuestionID" class="form-control" asp-items="ViewBag.QuestionID"></select>
                <span asp-validation-for="BsAnswer.QuestionID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BsAnswer.AnswerText" class="control-label"></label>
                <input asp-for="BsAnswer.AnswerText" class="form-control" />
                <span asp-validation-for="BsAnswer.AnswerText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BsAnswer.FileReference" class="control-label"></label>
                <input asp-for="BsAnswer.FileReference" class="form-control" />
                <span asp-validation-for="BsAnswer.FileReference" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BsAnswer.SubmittedAt" class="control-label"></label>
                <input asp-for="BsAnswer.SubmittedAt" class="form-control" />
                <span asp-validation-for="BsAnswer.SubmittedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BsAnswer.Status" class="control-label"></label>
                <input asp-for="BsAnswer.Status" class="form-control" />
                <span asp-validation-for="BsAnswer.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
