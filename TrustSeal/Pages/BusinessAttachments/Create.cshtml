@page
@model TrustSeal.Pages.BusinessAttachments.CreateModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create</title>
</head>
<body>

<h4>BusinessAttachment</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
           
            <div class="form-group">
                <label asp-for="Answer.Question.QuestionText" class="control-label"></label>
                <input asp-for="Answer.Question.QuestionText" class="form-control" disabled/>
                <span asp-validation-for="Answer.Question.QuestionText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Answer.AnswerText" class="control-label"></label>
                <input asp-for="Answer.AnswerText" class="form-control" disabled/>
                <span asp-validation-for="Answer.AnswerText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FormFiles">Attach Files</label>
                <input type="file" asp-for="FormFiles" multiple>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

</body>
</html>
