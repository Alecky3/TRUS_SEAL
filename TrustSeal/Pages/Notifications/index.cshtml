@page
@model IndexModel
@{
    ViewData["Title"] = "Notifications";
}
<section class="p-2 md:p-4 grid grid-col-1 gap-y-4">
    
@foreach(var not in Model.Notifications)
{
    <div class="flex items-start gap-2.5">
   <div class="flex flex-col w-full max-w-[600px] leading-1.5 p-4 border-gray-200 bg-gray-100 rounded-e-xl rounded-es-xl dark:bg-gray-700">
      <div class="flex items-center space-x-2 rtl:space-x-reverse">
         <span class="text-sm font-semibold text-gray-900 dark:text-white">@not.CreatedBy.Email</span>
         <span class="text-sm font-normal text-gray-500 dark:text-gray-400">@not.CreatedAt</span>
      </div>
      <p class="text-sm font-normal py-2.5 text-gray-900 dark:text-white">@not.Content</p>
   </div>
   
</div>

}
</section>