@page
@model TrustSeal.Pages.TsBusinesses.DetailsModel

@{
    ViewData["Title"] = "Business Details";
}

<section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-2xl lg:py-16">
        <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Business Details</h2>
        <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
            <div class="sm:col-span-2">
                <h3 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.LegalName)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.LegalName)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.RegistrationNumber)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.RegistrationNumber)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.TaxIdentificationNumber)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.TaxIdentificationNumber)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.IncorporationDate)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.IncorporationDate)</p>
            </div>
            <div class="sm:col-span-2">
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.StreetAddress)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.StreetAddress)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.City)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.City)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.PostalCode)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.PostalCode)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.Country)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.Country)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.PhoneNumber)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.PhoneNumber)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.Email)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.Email)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.Website)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.Website)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.PrimaryContactName)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.PrimaryContactName)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.PrimaryContactPhone)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.PrimaryContactPhone)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.PrimaryContactEmail)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.PrimaryContactEmail)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.BusinessType)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.BusinessType)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.IndustryCategory)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.IndustryCategory)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.IsVerified)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.IsVerified)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.SubmissionDate)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.SubmissionDate)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.Owner)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.Owner.Id)</p>
            </div>
        </div>
        <div class="mt-6 flex items-center space-x-4">
            <a asp-page="./Edit" asp-route-id="@Model.Business.Id" class="text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-gray-800 dark:hover:bg-gray-700 dark:focus:ring-gray-700 dark:border-gray-700">Edit</a>
            <a asp-page="./Index" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 font-medium rounded-lg text-sm px-5 py-2.5 mr-2 mb-2 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-600 dark:focus:ring-gray-700">Back to List</a>
        </div>
    </div>
</section>