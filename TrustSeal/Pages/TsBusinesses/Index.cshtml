@page
@model TrustSeal.Pages.TsBusinesses.IndexModel
@using Microsoft.AspNetCore.Identity
@using TrustSeal.Areas.Identity.Data

@inject UserManager<TSUser> UserManager

@{
    ViewData["Title"] = "Business Details";
    TSUser user = await UserManager.GetUserAsync(User);
    var role = await UserManager.GetRolesAsync(user);
    var IsAdmin = role.Contains("Admin");
}

<section class="container mx-auto over">
    
    <div class="w-full">
        <table id="businessDataTable" class="cell-border compact stripe" style="width: 100%;">
            <thead>
                <tr>
                <td>legalName</td>
                <td>registrationNumber</td>
                <td>taxIdentificationNumber</td>
                <td>country</td>
                <td>phoneNumber</td>
                <td>email</td>
                <td>isVerified</td>
                <td>submissionDate</td>
                @if(IsAdmin)
                {
                    <td >Actions</td>
                }
                </tr>
            </thead>
            <tbody>

            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        var IsAdmin = "@IsAdmin";
        console.log(IsAdmin)
        $(document).ready(function(){
            let businessDataTable = $("#businessDataTable").DataTable({
                deferRender:true,
                responsive: true,
                ajax: {
                    url: '/TsBusinesses?handler=Businesses',
                    dataSrc:'',
                },
                columns: [
                    {data:'legalName'},
                    {data:'registrationNumber'},
                    {data:'taxIdentificationNumber'},
                    {data:'country'},
                    {data:'phoneNumber'},
                    {data:'email'},
                    {data:'isVerified'},
                    {data:'submissionDate'},
                    {data:"caseNumber"},
                ],
                columnDefs:[
                {
                    targets:-1,
                    visible: IsAdmin.toString() == "True" ? true : false,
                    render:function(data,type,row)
                    {
                        
                        return `
                                <a href='/ReviewApplication?CaseNumber=${row.caseNumber}' class="font-medium text-blue-600 dark:text-blue-500 hover:underline">Review</a>
                                `
                        
                    }
                },
                ]
                })
            })
    </script>
}