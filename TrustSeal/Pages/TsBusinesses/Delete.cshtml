            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.TaxIdentificationNumber)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.TaxIdentificationNumber)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.IncorporationDate)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.IncorporationDate)</p>
            </div>
            <div class="sm:col-span-2">
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.StreetAddress)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.StreetAddress)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.City)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.City)</p>
            </div>
            <div>
                <h3 class="mb-2 text-sm font-medium text-gray-900 dark:text-white">@Html.DisplayNameFor(model => model.Business.PostalCode)</h3>
                <p class="text-sm text-gray-700 dark:text-gray-300">@Html.DisplayFor(model => model.Business.PostalCode)</p>
            </div>
            <div>
