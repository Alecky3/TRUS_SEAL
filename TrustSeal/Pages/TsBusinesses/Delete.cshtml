@page
@model TrustSeal.Pages.TsBusinesses.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-2xl lg:py-16">
        <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Delete </h2>
        <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Are you sure you want to delete this?</h3>

