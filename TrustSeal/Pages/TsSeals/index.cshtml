@page
@model TrustSeal.Pages.TsSeals.IndexModel
@using Microsoft.AspNetCore.Identity
@using TrustSeal.Areas.Identity.Data

@inject UserManager<TSUser> UserManager

@{
    ViewData["Title"] = "Seals";
    TSUser user = await UserManager.GetUserAsync(User);
    var role = await UserManager.GetRolesAsync(user);
    var IsAdmin = role.Contains("Admin");
}

<style>
        @* body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        } *@
.certificate-container {
    @* width: 80%; *@
    @* max-width: 900px; *@
    @* margin: 50px auto; *@
    padding: 30px;
    border: 10px solid #0a220b;
    border-radius: 15px;
    background-color: #fff;
    text-align: center;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25), 
                0 6px 6px rgba(0, 0, 0, 0.22); /* Enhanced shadow effect */
}


        .certificate-header {
            font-size: 2.5em;
            font-weight: bold;
            color: #0a220b;
            margin-bottom: 20px;
        }

        .certificate-subheader {
            font-size: 1.5em;
            margin-top: 10px;
            margin-bottom: 20px;
            color: #333;
        }

        .certificate-name {
            font-size: 2em;
            font-weight: bold;
            color: #000;
            margin: 20px 0;
        }

        .certificate-content {
            font-size: 1.2em;
            margin-bottom: 30px;
            color: #555;
            line-height: 1.6;
        }

        .certificate-badge {
    display: block; /* Ensures the image is treated as a block element */
    margin: 20px auto; /* Centers the image horizontally */
    max-width: 200px; /* Adjust the size as needed */
    height: auto; /* Maintains aspect ratio */
    border-radius: 10px; /* Optional: adds slightly rounded corners */
    box-shadow: 0 6px 8px rgba(0, 0, 0, 0.3); /* Optional: shadow effect */
}


        .certificate-footer {
            margin-top: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .certificate-signature img {
            max-width: 150px;
        }

        .certificate-date {
            font-size: 1.2em;
            color: #666;
        }

        .download-btn {
            margin-top: 20px;
            padding: 10px 20px;
            font-size: 1em;
            background-color: #1c311c;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
        }

        .download-btn:hover {
            background-color: #45a049;
        }
    </style>

@foreach(var seal in Model.Seals)
{
 <div class="grid grid-cols-1 md:grid-cols-3 gap-2 md:gap-4 mb-4 border border-2 border-gray-100 p-2 rounded-md">
        <div>
            <div class="certificate-container">
            <div class="certificate-header">Trust Seal Badge</div>
            <img src="@Url.Content("~/Badges/badge.svg")" alt="Trust Badge" class="certificate-badge">
            <div class="certificate-subheader">This is to certify that</div>
            <div class="certificate-name">@seal.Owner.FirstName</div>
            <div class="certificate-content">
                Has successfully completed the <strong>Business Verification</strong><br>
                on <strong>@seal.CreatedAt.ToShortDateString()</strong>.
            </div>
            <div class="certificate-footer">
                <div class="certificate-signature">
                    <img src="@Url.Content("~/Badges/signature.png")" alt="CEO Signature">
                    <p>CEO Signature</p>
                </div>
                <div class="certificate-date">Issued on: @seal.CreatedAt.ToShortDateString()</div>
            </div>
            <a href="#" class="download-btn" onclick="downloadCertificate()" class="mt-2">Download Certificate</a>
        </div>
        
    </div>
    <div class="col-span-2">
        <!-- List Group -->
        <ul class="mt-3 flex flex-col rounded-md">
            <li class="inline-flex items-center gap-x-2 py-3 px-4 text-sm border text-gray-800 -mt-px first:rounded-t-lg first:mt-0 last:rounded-b-lg dark:border-neutral-700 dark:text-neutral-200">
                <div class="flex items-center justify-between w-full">
                <span>Business Name</span>
                <span>@seal.BusinessLegalName</span>
                </div>
            </li>
            <li class="inline-flex items-center gap-x-2 py-3 px-4 text-sm border text-gray-800 -mt-px first:rounded-t-lg first:mt-0 last:rounded-b-lg dark:border-neutral-700 dark:text-neutral-200">
                <div class="flex items-center justify-between w-full">
                <span>Date Assigned</span>
                <span>@seal.CreatedAt</span>
                </div>
            </li>
            <li class="inline-flex items-center gap-x-2 py-3 px-4 text-sm font-semibold  border text-gray-800 -mt-px first:rounded-t-lg first:mt-0 last:rounded-b-lg dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-200">
                <div class="flex items-center justify-between w-full">
                <span>Valid Until</span>
                <span>@seal.ExpiresAt</span>
                </div>
            </li>
            <li class="inline-flex items-center gap-x-2 py-3 px-4 text-sm font-semibold  border text-gray-800 -mt-px first:rounded-t-lg first:mt-0 last:rounded-b-lg dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-200">
                <div class="flex items-center justify-between w-full">
                <span>Seal Code</span>
                <span>@seal.SealCode</span>
                </div>
            </li>
             <li class="inline-flex items-center gap-x-2 py-3 px-4 text-sm font-semibold  border text-gray-800 -mt-px first:rounded-t-lg first:mt-0 last:rounded-b-lg dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-200">
                <div class="flex items-center justify-between w-full">
                <span>Seal Id</span>
                <span>@seal.SealReadableId</span>
                </div>
            </li>
        </ul>
        <!-- End List Group -->
        <div>

            <!-- Modal toggle -->
            <button data-modal-target="embedseal-@seal.SealCode"  data-modal-toggle="embedseal-@seal.SealCode" class="block text-white mt-2 bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" type="button">
            Embed seal
            </button>

            <!-- Main modal -->
            <div id="embedseal-@seal.SealCode" data-modal-backdrop="static" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
                <div class="relative p-4 w-full max-w-2xl max-h-full">
                    <!-- Modal content -->
                    <div class="relative bg-white rounded-lg shadow-sm dark:bg-gray-700">
                        <!-- Modal header -->
                        <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600 border-gray-200">
                            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                                Embed Trustseal Guide
                            </h3>
                            <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="embedseal-@seal.SealCode">
                                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                                </svg>
                                <span class="sr-only">Close modal</span>
                            </button>
                        </div>
                        <!-- Modal body -->
                        <div class="p-4 md:p-5 space-y-4">
                            
                            <div class="mb-4 border-b border-gray-200 dark:border-gray-700">
                                <ul class="flex flex-wrap -mb-px text-sm font-medium text-center" id="htmlcode-tab" data-tabs-toggle="#embedcode-@seal.SealCode" role="tablist">
                                    <li class="me-2" role="presentation">
                                        <button class="inline-block p-4 border-b-2 rounded-t-lg" id="htmlcode-@seal.SealCode-tab" data-tabs-target="#htmlcode-@seal.SealCode" type="button" role="tab" aria-controls="htmlcode-@seal.SealCode" aria-selected="false">HTML Code</button>
                                    </li>
                                    <li class="me-2" role="presentation">
                                        <button class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300" id="csscode-@seal.SealCode-tab" data-tabs-target="#csscode-@seal.SealCode" type="button" role="tab" aria-controls="csscode-@seal.SealCode" aria-selected="false">CSS Code</button>
                                    </li>
                                </ul>
                            </div>
                            <div id="embedcode-@seal.SealCode">
                                <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="htmlcode-@seal.SealCode" role="tabpanel" aria-labelledby="htmlcode-@seal.SealCode-tab">
                                    <div>

                                        <label for="embedhtmlcode-@seal.SealCode" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Copy and paste below HTML code on your site,place it where your prefer the seal badge to be displayed</label>
                                        <textarea id="embedhtmlcode-@seal.SealCode" rows="4" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" >
                                            <a href="@(Model.Hostname)/SealPreview?sealcode=@seal.SealCode" class="hover-text" id="sealPreviedUrl">
                                                <img src="@Model.Hostname@Url.Content("~/Badges/badge.svg")" alt="Trust Seal Logo" style="width: 120px;height: 120px;">
                                            </img>
                                                <div class="tooltip-text bottom">
                                                    <div class="tooltip-item">
                                                        <span>Seal assigned By: </span>
                                                        <span class="tooltip-item-text">Kenya National Chanbers of Commerce & Industry</span>
                                                    </div>
                                                    <hr>
                                                    <div class="tooltip-item">
                                                        <span>Business Name: </span>
                                                        <span class="tooltip-item-text">@seal.BusinessLegalName</span>
                                                    </div>
                                                    <div class="tooltip-item">
                                                        <span>Date Assigned: </span>
                                                        <span class="tooltip-item-text">@seal.CreatedAt</span>
                                                    </div>
                                                    <div class="tooltip-item">
                                                        <span>Expires At: </span>
                                                        <span class="tooltip-item-text">@seal.ExpiresAt</span>
                                                    </div>
                                            </div>
                                            </a>
                                        </textarea>

                                    </div>
                                    <div >
                                        <button type="button" data-clipboard-target="#embedhtmlcode-@seal.SealCode" class="copyembedcode-btn px-5 py-2.5 text-sm mt-2 font-medium text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 rounded-lg text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Copy</button>
                                    </div>
                                </div>
                                <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="csscode-@seal.SealCode" role="tabpanel" aria-labelledby="csscode-@seal.SealCode-tab">
                                            <p class="text-sm text-gray-500 dark:text-gray-400">This is some placeholder content the <strong class="font-medium text-gray-800 dark:text-white">Dashboard tab's associated content</strong>. Clicking another tab will toggle the visibility of this one for the next. The tab JavaScript swaps classes to control the content visibility and styling.</p>
                                </div>
                             </div>

                        </div>
                        <!-- Modal footer -->
                        <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
                           
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
}

@section Scripts
{
    <script src="~/js/clipboard.min.js"></script>
    <script>
        let clipboardbtns = new ClipboardJS('.copyembedcode-btn');
       
    </script>

}